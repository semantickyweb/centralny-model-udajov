era-sh:RbcID
	a sh:PropertyShape ;
	rdfs:comment "Unique RBC identification (NID_C+NID_RBC) as defined in the specification referenced in TSI CCS."@en ;
	era:affectedClass era:RadioBlockCenter ;
	era:affectedProperty era:rbcID ;
	era:rinfIndex
		"1.1.1.3.2.17" ,
		"1.2.1.1.1.17"
		;
	era:scope "local" ;
	sh:datatype xsd:integer ;
	sh:maxCount "1"^^xsd:integer ;
	sh:maxInclusive "16777214"^^xsd:integer ;
	sh:message "rbcID (1.1.1.3.2.17, 1.2.1.1.1.17): The radio block center id must be represented as an integer between 0 and 16777214. This error may be due to having a value that is not an integer or that is out of range."@en ;
	sh:minCount "1"^^xsd:integer ;
	sh:minInclusive "0"^^xsd:integer ;
	sh:path era:rbcID ;
	sh:severity sh:Warning ;
