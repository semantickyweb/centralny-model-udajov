era-sh:ValidDate
	a sh:PropertyShape ;
	rdfs:comment "The effective date of the activity (e.g. revocation date)."@en ;
	era:affectedClass era:Activity ;
	era:affectedProperty dcterms:valid ;
	era:scope "local" ;
	sh:datatype xsd:dateTimeStamp ;
	sh:maxCount "1"^^xsd:integer ;
	sh:message "dct:valid: An Activity may have at most one valid date that must be an xsd:date. This error may be due to having more than one value or having a value that is not a date."@en ;
	sh:path dcterms:valid ;
	sh:severity sh:Violation ;
	.

era-sh:Validity
	a sh:PropertyShape ;
	rdfs:comment "Relates a feature with a temporal feature to indicate a validity period. "@en ;
	era:affectedClass era:Feature ;
	era:affectedProperty era:validity ;
	era:scope "local" ;
	sh:class era:TemporalFeature ;
	sh:message "validity: The feature has a validity value that points to an instance of TemporalFeature. This error is due to having a value that is not an instance of TemporalFeature."@en ;
	sh:path era:validity ;
	sh:severity sh:Violation ;
	.

era-sh:ValidityMustEnglobeChildren
	a sh:SPARQLConstraint ;
	rdfs:comment "If an InfrastructureElement has a bounded validity period, the validity of each direct child (via era:isPartOf or era:hasPart) must be contained within the parent's validity bounds."@en ;
	era:affectedClass era:InfrastructureElement ;
	era:affectedProperty era:validity ;
	era:scope "local" ;
	sh:message "validity: The infrastructure element {$this} has a validity period that does not englobe the validity of its child {?child}. Each child's validity must start no earlier than the parent's start and end no later than the parent's end."@en ;
	sh:prefixes <http://data.europa.eu/949/> ;
	sh:select """
    PREFIX time: <http://www.w3.org/2006/time#>
    
    SELECT DISTINCT $this ?child (era:validity AS ?path)
    WHERE {
        $this a era:InfrastructureElement .
        { ?child era:isPartOf $this } UNION { $this era:hasPart ?child }

        OPTIONAL { $this era:validity/time:hasBeginning/time:inXSDDate     ?psd }
        OPTIONAL { $this era:validity/time:hasBeginning/time:inXSDDateTime ?psdt }
        OPTIONAL { $this era:validity/time:hasEnd/time:inXSDDate           ?ped }
        OPTIONAL { $this era:validity/time:hasEnd/time:inXSDDateTime       ?pedt }

        OPTIONAL { ?child era:validity/time:hasBeginning/time:inXSDDate     ?csd }
        OPTIONAL { ?child era:validity/time:hasBeginning/time:inXSDDateTime ?csdt }
        OPTIONAL { ?child era:validity/time:hasEnd/time:inXSDDate           ?ced }
        OPTIONAL { ?child era:validity/time:hasEnd/time:inXSDDateTime       ?cedt }

        BIND(COALESCE(STR(?psd), SUBSTR(STR(?psdt), 0, 10)) AS ?ps)
        BIND(COALESCE(STR(?ped), SUBSTR(STR(?pedt), 0, 10)) AS ?pe)
        BIND(COALESCE(STR(?csd), SUBSTR(STR(?csdt), 0, 10)) AS ?cs)
        BIND(COALESCE(STR(?ced), SUBSTR(STR(?cedt), 0, 10)) AS ?ce)

        FILTER(
            (BOUND(?ps) || BOUND(?pe))
            &&
            (
                (BOUND(?ps) && !BOUND(?cs))
                || (BOUND(?ps) && BOUND(?cs) && ?cs < ?ps)
                || (BOUND(?pe) && !BOUND(?ce))
                || (BOUND(?pe) && BOUND(?ce) && ?ce > ?pe)
            )
        )
    }
""" ;
	.

era-sh:VehicleTypesCompatibleTrafficLoad
	a sh:PropertyShape ;
	rdfs:comment "List of vehicle types already identified as compatible with Traffic load and load carrying capacity of infrastructure and train detection systems."@en ;
	era:affectedClass
		era:CommonCharacteristicsSubset ,
		era:RunningTrack
		;
	era:affectedProperty era:vehicleTypesCompatibleTrafficLoad ;
	era:rinfIndex "1.1.1.5.1" ;
	era:scope "local" ;
	sh:message "vehicleTypesCompatibleTrafficLoad (1.1.1.5.1): The subset with common characteristics may have values for vehicle types compatible with traffic load and each must be an IRI (a Document or VehicleType). This error may be due to having a value that is not an IRI."@en ;
	sh:nodeKind sh:IRI ;
	sh:or (
		[
			sh:class era:Document ;
		]
		[
			sh:class era:VehicleType ;
		]
	) ;
	sh:path era:vehicleTypesCompatibleTrafficLoad ;
	sh:severity sh:Violation ;
	.

era-sh:VehiclesCompatibleTrafficLoad
