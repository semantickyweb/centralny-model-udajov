era-sh:NotYetAvailableSPARQLTarget
	a sh:SPARQLTarget ;
	sh:prefixes <http://data.europa.eu/949/> ;
	sh:select """
        SELECT DISTINCT $this {
            $this era:notYetAvailable ?o .
            FILTER NOT EXISTS {
                $this a ?type .
                ?type rdfs:subClassOf* era:InfrastructureElement .
