	sh:class era:TopologicalCoordinate ;
	sh:maxCount "1"^^xsd:integer ;
	sh:message "hasTopoCoordinate: The net point reference must specify exactly one topo coordinate that is an instance of a TopologicalCoordinate. This error is due to not having a value, having more than one value, or having a value that is not an instance of TopologicalCoordinate."@en ;
	sh:minCount "1"^^xsd:integer ;
	sh:path era:hasTopoCoordinate ;
	sh:severity sh:Violation ;
	.

era-sh:HasWalkway
	a sh:PropertyShape ;
	rdfs:comment "Indication of existence of walkways."@en ;
	era:affectedClass era:Tunnel ;
	era:affectedProperty era:hasWalkway ;
	era:rinfIndex
		"1.1.1.1.8.12" ,
		"1.2.1.0.5.10" ,
		"1.2.2.0.5.9"
		;
	era:scope "local" ;
	sh:datatype xsd:boolean ;
	sh:maxCount "1"^^xsd:integer ;
