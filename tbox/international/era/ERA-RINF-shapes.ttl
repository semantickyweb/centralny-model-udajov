	.

era-sh:InNUTS3
	a sh:PropertyShape ;
	rdfs:comment "Reference to NUTS-3 place or city"@en ;
	era:affectedClass era:PrimaryLocation ;
	era:affectedProperty era:inNUTS3 ;
	era:scope "local" ;
	sh:class skos:Concept ;
	sh:maxCount "1"^^xsd:integer ;
