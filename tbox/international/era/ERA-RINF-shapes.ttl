	sh:message "additionalBrakingInformationDocument (1.1.1.3.11.3): This error is due to the track {?trackLabel} , violating the rule: Y in case of Y for 1.1.1.3.11.2."@en ;
	sh:prefixes <http://data.europa.eu/949/> ;
	sh:select '''
