		era:notApplicable
		era:notYetAvailable
		era:operatingLanguage
		era:parameterApplicability
		era:primaryLocation
		era:validity
		geo:hasGeometry
		rdfs:label
	) ;
	sh:nodeKind sh:IRI ;
	sh:property
