era-sh:VkmCode
	a sh:PropertyShape ;
	rdfs:comment "VKM code is an alphanumeric code, consisting of 2 to 5 letters."@en ;
	era:affectedClass era:VehicleKeeperMarking ;
	era:affectedProperty era:vkmCode ;
	era:scope "local" ;
	sh:datatype xsd:string ;
	sh:maxCount "1"^^xsd:integer ;
