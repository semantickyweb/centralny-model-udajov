	sh:targetClass vpa:Case ;
	.

era-sh:CaseTypeConsistency
	a sh:PropertyShape ;
	era:affectedProperty dcterms:type ;
	sh:path dcterms:type ;
	sh:severity sh:Violation ;
	sh:sparql era-sh:CaseTypeConsistencySparqlConstraint ;
	.

era-sh:CaseTypeConsistencySparqlConstraint
	a sh:SPARQLConstraint ;
	sh:message "Case type PRE4RP must be part of a Certificate of type APIS"@en ;
	sh:prefixes <http://data.europa.eu/949/> ;
	sh:select """
      PREFIX era-va-authcase-eratv: <http://data.europa.eu/949/concepts/va-authcase-eratv/>
      PREFIX era-permission-types: <http://data.europa.eu/949/concepts/permission-types/>

      SELECT $this 
      WHERE {
        $this dct:type era-va-authcase-eratv:PRE4RP .
        ?certificate vpa:requestedIn/vpa:constitutedBy $this .
        FILTER NOT EXISTS { $certificate dct:type era-permission-types:APIS }
      }
    """ ;
	.

