	sh:datatype xsd:gYear ;
	sh:maxCount "1"^^xsd:integer ;
	sh:message "manufacturingYear (5.1): The value must be a 4-digit year (gYear)."@en ;
	sh:path era:manufacturingYear ;
	sh:pattern "^[0-9]{4}$" ;
	sh:severity sh:Violation ;
	.

