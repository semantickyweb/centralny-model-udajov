era-sh-evr:BillingOrganisation
	a sh:PropertyShape ;
	rdfs:comment "The body to which billing contact and billing information for this body must be addressed."@en ;
	era:affectedClass era:Body ;
	era:affectedProperty era:billingOrganisation ;
	era:scope "local" ;
	sh:class era:Body ;
	sh:maxCount "1"^^xsd:integer ;
	sh:message "billingOrganisation: A Body must have at most one billingOrganisation, and its value must be an IRI identifying an instance of era:Body."@en ;
	sh:nodeKind sh:IRI ;
	sh:path era:billingOrganisation ;
	sh:severity sh:Violation ;
	.

era-sh-evr:BillingOrganisationOnlyForApplicantOrKeeper
	a sh:SPARQLConstraint ;
	rdfs:comment "A Body may only have a value for billingOrganisation if it plays the Applicant (<http://data.europa.eu/949/concepts/organisation-roles/Applicant>) or the Keeper (<http://data.europa.eu/949/concepts/organisation-roles/Keeper>) organisation role."@en ;
	era:affectedClass era:Body ;
	era:affectedProperty era:billingOrganisation ;
	era:scope "local" ;
	sh:message "billingOrganisation: The Body {$this} with label {?label} has a billingOrganisation {?value} but none of its organisation roles is Applicant or Keeper. A billingOrganisation is only allowed for bodies playing the Applicant or the Keeper role."@en ;
	sh:prefixes <http://data.europa.eu/949/> ;
	sh:select '''
    SELECT $this ?label ?value (era:billingOrganisation AS ?path)
    WHERE {
        $this era:billingOrganisation ?value .
        OPTIONAL { $this rdfs:label ?label0 } .
        BIND(COALESCE(?label0, "unknown label") AS ?label)
        FILTER NOT EXISTS {
            $this era:role/era:hasOrganisationRole ?role .
            VALUES ?role {
                <http://data.europa.eu/949/concepts/organisation-roles/Applicant>
                <http://data.europa.eu/949/concepts/organisation-roles/Keeper>
            }
        }
    }
''' ;
	sh:severity sh:Violation ;
	.

