era-sh:InSkosConceptScheme
	a sh:NodeShape ;
	sh:message "Instance {$this} of class {?class} has enumerated property {?property} with value {?value} that is not in the list {?scheme}. The value must be in the list of concepts defined in the SKOS concept scheme."@en ;
	sh:severity sh:Violation ;
	sh:sparql era-sh:InSkosConceptSchemeConstraint ;
	sh:target [
		a sh:SPARQLTarget ;
		sh:prefixes <http://data.europa.eu/949/> ;
		sh:select """
      SELECT distinct $this ?property {
        $this ?property ?value .
        ?property era:inSkosConceptScheme ?scheme .
        # FILTER NOT EXISTS {?value skos:inScheme ?scheme}
      }
    """ ;
	] ;
	.

era-sh:InSkosConceptSchemeConstraint
	a sh:SPARQLConstraint ;
	sh:prefixes <http://data.europa.eu/949/> ;
	sh:select """
      SELECT $this ?class ?property ?value ?scheme {
        $this a         ?class;
              ?property ?value .
        ?property era:inSkosConceptScheme ?scheme .
        FILTER NOT EXISTS {?value skos:inScheme ?scheme}
      }
    """ ;
	.

era-sh:IncludedVersionsVariant
	a sh:PropertyShape ;
	rdfs:comment "Validation for includedVersionsVariant property."@en ;
	era:affectedClass era:VehicleType ;
	era:affectedProperty era:includedVersionsVariant ;
	era:eratvIndex
		"0.2" ,
		"0.4"
		;
	sh:datatype xsd:string ;
	sh:message "The includedVersionsVariant value must be exactly three alphanumeric characters (e.g., 'A1B', 'XYZ', '012')."@en ;
	sh:path era:includedVersionsVariant ;
	sh:pattern "^[a-zA-Z0-9]{3}(-[a-zA-Z0-9]{3})?$" ;
	sh:severity sh:Violation ;
	.

