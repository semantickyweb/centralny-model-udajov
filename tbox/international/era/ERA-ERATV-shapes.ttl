era-sh:AllEraPropertiesTarget
	a sh:SPARQLTarget ;
	era:scope "local" ;
	sh:prefixes <http://data.europa.eu/949/> ;
	sh:select '''
        SELECT DISTINCT ?this
        WHERE {
          ?s ?this ?o .
          FILTER(STRSTARTS(STR(?this), "http://data.europa.eu/949/")) .
        }
    ''' ;
	.

era-sh:AllEraTypesTarget
