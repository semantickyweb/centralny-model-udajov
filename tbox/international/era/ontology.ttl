###  http://data.europa.eu/949/errorCorrectionsOnboard
era:errorCorrectionsOnboard rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf era:ccsSubsystemDeclarationsVerificationTrackObjParameter ;
                            rdfs:domain [ rdf:type owl:Class ;
                                          owl:unionOf ( era:CommonCharacteristicsSubset
                                                        era:RunningTrack
                                                      )
                                        ] ;
                            rdfs:range skos:Concept ;
                            era:applicable "Y/N" ;
                            era:dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
                            era:inSkosConceptScheme <http://data.europa.eu/949/concepts/error-corrections/OnboardErrorCorrections> ;
                            era:legalDeadline "12 months after the entry into force of TSI CCS and at least 12 months after publication of Article 7 Guide"@en ;
                            era:rinfIndex "1.1.1.3.1.2" ,
                                          "1.2.1.1.1.19" ;
                            era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/InSkosConceptScheme> ,
                                                         <http://data.europa.eu/949/shapes/ErrorCorrectionsOnboard> ;
                            dcterms:created "2024-04-18"^^xsd:date ;
                            dcterms:modified "2025-02-18"^^xsd:date ,
                                             "2025-02-28"^^xsd:date ;
                            dcterms:replaces era:ertmsErrorCorrectionsOnBoard ,
                                             era:etcsErrorCorrectionsOnboard ,
                                             era:gsmrErrorCorrectionsOnboard ;
                            dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
                            rdfs:comment "List of unacceptable errors impacting the IM network that are required to be solved in the on-board according to the TSI CCS point 7.2.10.3 specification maintenance point (ETCS, GSM-R and/or ATO). An additional parameter (era:errorCorrectionsOnboardExplanation) must document if a non-implemented CR has been accepted by the IM."@en ;
                            rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                            rdfs:label "Error corrections required for the on-board ETCS, GSM-R and/or ATO function"@en ;
                            vs:term_status "stable" ;
                            skos:scopeNote """This parameter should be limited to those required for the onboard, in order to allow normal service as defined in Art. 10 CR. The values will come from a list.
IM's may choose to make available the optional ETCS error corrections as well, but this should be done using other means than the RINF register.
This parameter should also be understood as ETCS, ATO and GSM-R related error corrections required for the on-board. pending a formal update and approval of the relevant legislative annex.
For the specific track the error corrections to be applied is one list only."""@en .


###  http://data.europa.eu/949/etcs
era:etcs rdf:type owl:ObjectProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( era:CommonCharacteristicsSubset
                                     era:RunningTrack
                                   )
                     ] ;
         rdfs:range era:ETCS ;
         era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/Etcs> ;
         dcterms:created "2021-08-07"^^xsd:date ;
         dcterms:modified "2021-09-12"^^xsd:date ,
                          "2024-08-13"^^xsd:date ,
                          "2024-09-19"^^xsd:date ,
                          "2025-02-28"^^xsd:date ,
                          "2026-07-10"^^xsd:date ;
         rdfs:comment "European Train Control System (ETCS) application level supported by the track side equipment."@en ;
         rdfs:isDefinedBy <http://data.europa.eu/949/> ;
         rdfs:label "TSI compliant train protection system (ETCS)"@en ;
         vs:term_status "stable" ;
         skos:scopeNote """It can be repeated as many times as the number of different ETCS levels are present.

For RDF data provision:
The value of this property is an instance of the era:ETCS, which has as properties the parameters 1.1.1.3.2.1 and 1.1.1.3.2.2.

For RINF XML data sets:
As long as the data provision through XML data sets is allowed, this property is the equivalent of the \"Set\" attribute, grouping parameters 1.1.1.3.2.1 and 1.1.1.3.2.2.

If the track is only equipped with a Class B system (i.e. no ETCS on the trackside), this must be reflected on the relevant Class B parameter (Parameter 1.1.1.3.5.3, era:protectionLegacySystem) and the era:etcs property is not applicable. In that case no era:ETCS resource is created; instead, the non-applicability is declared explicitly on the infrastructure element (e.g. the running track) with era:notApplicable era:etcs."""@en .


