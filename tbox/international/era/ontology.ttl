###  http://data.europa.eu/949/loadCapability
era:loadCapability rdf:type owl:ObjectProperty ;
                   rdfs:range skos:Concept ;
                   era:XMLName "IPP_LoadCap" ;
                   era:inSkosConceptScheme <http://data.europa.eu/949/concepts/load-capability-line-categories/LoadCapabilityLineCategories> ;
                   era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/InSkosConceptScheme> ;
                   era:rinfIndex "1.1.1.1.2.4" ;
                   era:usedInRCCCalculations "true"^^xsd:boolean ;
                   dcterms:created "2020-08-24"^^xsd:date ;
                   dcterms:isReplacedBy era:LoadCapability ,
                                        era:loadCapabilityLineCategory ,
                                        era:loadCapabilitySpeed ,
                                        era:trackLoadCapability ;
                   dcterms:modified "2023-01-20"^^xsd:date ,
                                    "2024-09-19"^^xsd:date ;
                   rdfs:comment "A combination of the line category and speed at the weakest point of the track. The reason for deprecation is that the load capability property 1.1.1.1.2.4 was defined incorrectly as a SKOS property. It is composed of two values: (1)  line category, and (2) speed. Only line category is a list of predefined values (SKOS), whereas speed is an integer (according to the RINF application guide)."@en ;
                   rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                   rdfs:label "Load Capability"@en ;
                   owl:deprecated "true"^^xsd:boolean ;
                   vs:term_status "stable" .


###  http://data.europa.eu/949/loadCapabilityLineCategory
era:loadCapabilityLineCategory rdf:type owl:ObjectProperty ,
                                        owl:FunctionalProperty ;
                               rdfs:domain era:LoadCapability ;
                               rdfs:range skos:Concept ;
                               era:inSkosConceptScheme <http://data.europa.eu/949/concepts/load-capability-line-categories/LoadCapabilityLineCategories> ;
                               era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/InSkosConceptScheme> ,
                                                            <http://data.europa.eu/949/shapes/LoadCapabilityLineCategory> ;
