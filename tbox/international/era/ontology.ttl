###  http://data.europa.eu/949/existenceOfIndustrialRisk
era:existenceOfIndustrialRisk rdf:type owl:DatatypeProperty ;
                              rdfs:subPropertyOf era:routeBookDataParameter ;
                              rdf:type owl:FunctionalProperty ;
                              rdfs:domain [ rdf:type owl:Class ;
                                            owl:unionOf ( era:CommonCharacteristicsSubset
                                                          era:SectionOfLine
                                                        )
                                          ] ;
                              rdfs:range xsd:boolean ;
                              era:XMLName "RBS_IndRisks" ;
                              era:applicable "Y/NYA" ;
                              era:formatNote "Y/N" ;
                              era:legalDeadline "12 months after publication of Article 7 Guide"@en ;
                              era:rinfIndex "1.1.0.0.1.1" ;
                              era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ExistenceOfIndustrialRisk> ;
                              era:tsiOPEAppendixD2Index "3.2.5" ;
                              dcterms:created "2025-01-30"^^xsd:date ;
                              rdfs:comment "Indication that the full section of line (or a part of it) it is identified by the Infrastructure Managers (and communicated to the RU) where drivers are not supposed to get off the locomotive."@en ;
                              rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                              rdfs:label "Industrial risks — locations where it is dangerous for the driver to step out"@en ;
                              vs:term_status "stable" ;
                              skos:scopeNote """Although it is just an indication of existence of an industrial risk, the area covering the industrial risk should be references on the topological network.
For the route book purpose, the industrial risks should be defined as linear references instead of area. SpecialArea of type \"industrial risk\" should be used"""@en .


