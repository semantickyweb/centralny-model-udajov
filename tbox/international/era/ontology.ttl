         era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/BodyShape> ;
         dcterms:created "2024-06-03"^^xsd:date ;
         dcterms:modified "2025-02-18"^^xsd:date ;
         dcterms:replaces era:InfrastructureManager ,
                          era:Manufacturer ,
                          era:VehicleKeeper ;
         rdfs:comment "Is an organisation or a physical person"@en ;
         rdfs:isDefinedBy <http://data.europa.eu/949/> ;
         rdfs:label "Body"@en .


###  http://data.europa.eu/949/BrakingPerformance
era:BrakingPerformance rdf:type owl:Class ;
