###  http://data.europa.eu/949/TSIMagneticFields
era:TSIMagneticFields rdf:type owl:ObjectProperty ;
                      rdfs:range skos:Concept ;
                      era:applicable "Y/N/NYA" ;
                      era:inSkosConceptScheme <http://data.europa.eu/949/concepts/tsi-existence-and-compliances/TSIExistenceAndCompliances> ;
                      era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/InSkosConceptScheme> ;
                      era:legalDeadline "12 months after publication of Article 7 Guide"@en ,
                                        "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                      era:rinfIndex "1.1.1.3.9.1" ,
                                    "1.2.1.1.8.1" ;
                      dcterms:created "2021-08-09"^^xsd:date ;
                      dcterms:isReplacedBy era:tsiMagneticFields ;
                      dcterms:modified "2021-09-12"^^xsd:date ,
                                       "2024-04-25"^^xsd:date ,
                                       "2025-03-04"^^xsd:date ;
                      rdfs:comment "Indication whether rules exist and are compliant with the TSI."@en ;
                      rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                      rdfs:label "Existence and TSI compliance of rules for magnetic fields emitted by a vehicle"@en ;
                      rdfs:seeAlso "https://www.era.europa.eu/sites/default/files/2025-06/ag%20era_ertms_0033281v5_v1.pdf"^^xsd:anyURI ;
                      owl:deprecated "true"^^xsd:boolean ;
                      vs:term_status "stable" .


###  http://data.europa.eu/949/TSITractionHarmonics
era:TSITractionHarmonics rdf:type owl:ObjectProperty ;
                         rdfs:range skos:Concept ;
                         era:XMLName "CEI_TSITractionHarmonics" ;
                         era:applicable "Y/N/NYA" ;
                         era:inSkosConceptScheme <http://data.europa.eu/949/concepts/tsi-compliances/TSICompliances> ;
                         era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/InSkosConceptScheme> ;
                         era:legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en ,
                                           "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                         era:rinfIndex "1.1.1.3.9.2" ,
                                       "1.2.1.1.8.2" ;
                         dcterms:created "2021-08-09"^^xsd:date ;
                         dcterms:isReplacedBy era:tsiTractionHarmonics ;
                         dcterms:modified "2021-09-12"^^xsd:date ,
                                          "2025-03-04"^^xsd:date ;
                         dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
                         rdfs:comment "Indication whether rules exist and are compliant with the TSI."@en ;
                         rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                         rdfs:label "Existence and TSI compliance of limits in harmonics in the traction current of vehicles"@en ;
                         owl:deprecated "true"^^xsd:boolean ;
                         vs:term_status "stable" ;
                         skos:scopeNote """Compatibility with track circuits and wheel detectors of axle counters. The harmonics in the traction current in the rails can interfere with the operation of track circuits. The DC current in the rails may saturate the detectors of the axle counters, preventing their  operation. 
 none  shall be selected when respective national rules do not exist."""@en .


###  http://data.europa.eu/949/accelerationLevelCrossing
era:accelerationLevelCrossing rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf era:healthSafetyAndEnvironmentObjParameter ;
                              rdf:type owl:FunctionalProperty ;
                              rdfs:domain [ rdf:type owl:Class ;
                                            owl:unionOf ( era:CommonCharacteristicsSubset
                                                          era:Track
                                                        )
                                          ] ;
                              rdfs:range era:Document ;
                              era:XMLName "IHS_AccelerationLevelCrossing" ;
                              era:applicable "Y/N" ;
                              era:dependencyNote "Mandatory value when the level crossing is defined"@en ;
                              era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                              era:rinfIndex "1.1.1.1.7.3" ;
                              era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/AccelerationLevelCrossing> ,
                                                           <http://data.europa.eu/949/shapes/AccelerationLevelCrossingApplicability> ;
                              dcterms:created "2021-08-03"^^xsd:date ;
                              dcterms:modified "2024-01-08"^^xsd:date ,
                                               "2024-11-20"^^xsd:date ;
                              rdfs:comment "Existence of limit for acceleration of train if stopping or recovering speed close to a level crossing expressed in a specific reference acceleration curve."@en ;
                              rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                              rdfs:label "Acceleration allowed near level crossing"@en ;
                              vs:term_status "stable" ;
                              skos:scopeNote """The value of this parameter should be either a reference to a file name or an external link to a document. 
If a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the \"Reference Documents Management\" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document. 
If an external link is provided, the IM must ensure that the document is available at the provided link."""@en .


###  http://data.europa.eu/949/additionalBrakingInformationDocument
era:additionalBrakingInformationDocument rdf:type owl:ObjectProperty ;
                                         rdfs:subPropertyOf era:brakeRelatedObjParameter ;
                                         rdfs:domain [ rdf:type owl:Class ;
                                                       owl:unionOf ( era:CommonCharacteristicsSubset
                                                                     era:RunningTrack
                                                                   )
                                                     ] ;
                                         rdfs:range era:Document ;
                                         era:XMLName "CBP_BrakePerfDocRef" ;
                                         era:applicable "Y/N" ;
                                         era:dependencyNote "Only applicable when for parameter 1.1.1.3.11.2 True is selected"@en ;
                                         era:legalDeadline "16 January 2020"@en ;
                                         era:rinfIndex "1.1.1.3.11.3" ;
                                         era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/AdditionalBrakingInformationDocument> ,
                                                                      <http://data.europa.eu/949/shapes/AdditionalBrakingInformationDocumentApplicability> ;
                                         era:usedInRCCCalculations "true"^^xsd:boolean ;
                                         dcterms:created "2020-08-24"^^xsd:date ;
                                         dcterms:modified "2024-01-08"^^xsd:date ,
                                                          "2024-04-23"^^xsd:date ;
                                         rdfs:comment "Electronic document available in two EU languages from the IM stored by the Agency providing additional information as defined in point (2) of point 4.2.2.6.2 of TSI OPE."@en ;
                                         rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                         rdfs:label "Documents available by the IM relating to braking performance"@en ;
                                         vs:term_status "stable" ;
                                         skos:changeNote "Change from datatype property to object property in order to point to the class Document (reference document)"@en ;
                                         skos:scopeNote """The value of this parameter should be either a reference to a file name or an external link to a document. 
If a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the \"Reference Documents Management\" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document. 
If an external link is provided, the IM must ensure that the document is available at the provided link."""@en .


###  http://data.europa.eu/949/additionalVehicleConditions
era:additionalVehicleConditions rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf era:vehicleTechnicalObjCharacteristic ;
                                rdfs:domain era:VehicleRegistrationCase ;
                                rdfs:range skos:Concept ;
                                era:evrIndex "4.1" ;
                                era:inSkosConceptScheme <http://data.europa.eu/949/concepts/international-vehicle-agreements/InternationalVehicleAgreements> ;
                                era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/InSkosConceptScheme> ,
                                                             <http://data.europa.eu/949/shapes/AdditionalVehicleConditions> ;
                                dcterms:created "2025-03-19"^^xsd:date ;
                                rdfs:comment "Identification of applicable bilateral or multilateral agreements such as RIV, RIC, TEN, TEN-CW, TEN-GE, …. Other conditions can be added elsewhere."@en ;
                                rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                rdfs:label "Additional conditions applicable to the vehicle"@en ;
                                vs:term_status "stable" .


