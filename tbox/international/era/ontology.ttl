###  http://data.europa.eu/949/verificationSRT
era:verificationSRT rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf era:tunnelDataParameter ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( era:CommonCharacteristicsSubset
                                                era:Tunnel
                                              )
                                ] ;
                    rdfs:range xsd:string ;
                    era:XMLName "ITU_ECVerification" ;
                    era:applicable "Y/N" ;
                    era:formatNote "CC/RRRRRRRRRRRRRR/YYYY/NNNNNN" ;
                    era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                    era:rinfIndex "1.1.1.1.8.5" ,
                                  "1.2.1.0.5.3" ,
                                  "1.2.2.0.5.3" ;
                    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/VerificationSRT> ;
                    dcterms:created "2021-08-03"^^xsd:date ;
                    dcterms:modified "2024-01-08"^^xsd:date ,
                                     "2024-09-19"^^xsd:date ;
                    dcterms:source <http://data.europa.eu/eli/reg/2014/1303/2024-01-29> ;
                    rdfs:comment "Unique number for EC declarations in accordance with Commission Implementing Regulation (EU) 2019/250."@en ;
                    rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                    rdfs:label "EC declaration of verification relating to compliance with the requirements from TSIs applicable to railway tunnel"@en ;
                    rdfs:seeAlso "Document about practical arrangements for transmitting interoperability documents ERA/INF/10-2009/INT" ;
                    vs:term_status "stable" ;
                    skos:scopeNote """(SRT) in title means that here we include only declarations concerning requirements of SRT TSI for infrastructure system on the specific track.
Parameter shall be repeated when different EC declarations were issued for different elements of infrastructure subsystem on the specific track in the tunnel.
With the extension of scope according to Interoperability Directive 2016/797, geographical scope of the INF, ENE and CCS TSIs now includes all the networks (TEN and off-TEN) with the following nominal track gauges: 1435, 1520, 1524, 1600 and 1668 mm """@en .


