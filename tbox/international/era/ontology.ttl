###  http://data.europa.eu/949/includedVersions
era:includedVersions rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf era:vehicleTypeTechnicalDataCharacteristic ;
                     rdfs:domain era:VehicleType ;
                     rdfs:range xsd:string ;
                     era:eratvIndex "0.2" ;
                     era:wasInvalidatedBy <http://data.europa.eu/eli/reg_impl/2019/776/oj/eng> ;
                     dcterms:created "2025-02-14"^^xsd:date ;
                     dcterms:source <http://data.europa.eu/eli/dec_impl/2011/665> ;
                     rdfs:comment """Reserved for VehicleTypes authorised before the Fourth Railway Package.

Complementing the vehicleTypeNumber of 10 characters, is maximally one 3-digit group ('XXX'), which represent
the type's evolution after creation."""@en ;
                     rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                     rdfs:label "Type number"@en ;
                     rdfs:seeAlso "https://eur-lex.europa.eu/eli/dec_impl/2011/665#anx_II"^^xsd:anyURI ;
                     owl:deprecated "true"^^xsd:boolean ;
                     dcterms:isRequiredBy <http://data.europa.eu/eli/dec_impl/2011/665/oj> ;
                     vs:term_status "stable" .


###  http://data.europa.eu/949/includedVersionsVariant
era:includedVersionsVariant rdf:type owl:DatatypeProperty ;
                            rdfs:subPropertyOf era:vehicleTypeTechnicalDataCharacteristic ;
                            rdfs:domain era:VehicleType ;
                            rdfs:range xsd:string ;
