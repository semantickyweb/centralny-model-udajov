                   dcterms:created "2025-02-24"^^xsd:date ;
                   rdfs:comment "Stub class for braking profile under applicable load condition, stopping distance, deceleration and initial speed"@en ;
                   rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                   rdfs:label "Braking profile"@en .


###  http://data.europa.eu/949/Bridge
era:Bridge rdf:type owl:Class ;
           rdfs:subClassOf era:InfrastructureElement ;
           owl:disjointWith era:HABD ,
                            era:KilometricPost ,
                            era:LevelCrossing ,
                            era:OperationalPoint ,
                            era:PlatformEdge ,
                            era:PrimaryLocation ,
                            era:RadioBlockCenter ,
                            era:RunningTrack ,
                            era:SectionOfLine ,
                            era:Siding ,
                            era:Signal ,
                            era:SpecialArea ,
                            era:Switch ,
                            era:Track ,
                            era:Tunnel ;
           era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/BridgeShape> ;
           dcterms:modified "2025-01-30"^^xsd:date ,
                            "2025-03-01"^^xsd:date ;
           rdfs:comment "It is a structure constructed for the exclusive purpose of carrying railroad traffic across an obstruction. It can be used for defining non-stopping areas, big metal mass, resistance to traffic load etc."@en ;
           rdfs:isDefinedBy <http://data.europa.eu/949/> ;
           rdfs:label "Bridge"@en .

###  http://data.europa.eu/949/CABAddition
era:CABAddition rdf:type owl:Class ;
                rdfs:subClassOf era:Restriction ;
                era:usedInEradis true ;
                dcterms:created "2025-07-18"^^xsd:date ;
                rdfs:comment "An additionally allowed Option, Added Function which was confirmed by a CAB"@en ;
                rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                rdfs:label "CAB assessed addition"@en ;
                rdfs:seeAlso "https://nb-rail.eu/official-documents"^^xsd:anyURI ;
                vs:term_status "stable" ;
                skos:example """era-cld:cld-NoBoCert-25403 a era:CertificationLevelDocument , vpa:EvidenceDocument ;
  vpa:checkedCompliance [
    # Assessment Requirements regarding TSI
    a era:CABAssessmentCheck ;
    era:isOptional "false"^^xsd:boolean ;
    era:complianceResult era-compliance:FullyCompliant ;
    vpa:checkedRequirement eralex:cir-2016-919, eralex:cir-2019-776, eralex:cir-2020-387, eralex:cir-2020-420 ;
  ] , [
    a era:CABAssessmentCheck ;
    era:isOptional \"true\"^^xsd:boolean ;
    era:complianceResult era-compliance:FullyCompliant ;
    vpa:withRestriction [
      a era:CABAddition;
      dcterms:type era-cld-addition-types:Option ;              # WARNING, SKOS Concept scheme only in version 4.0.0+
      dcterms:description "{Describe the optional function here}"
      era:nonCodedRestrictions "{Conditions and Limits of Use regarding this Optional Function}"@en ;
      dcterms:source era-cld-additional-function-reasons:R4     # WARNING, SKOS Concept scheme only in version 4.0.0+
    ]
  ].""" ;
                skos:scopeNote """This class is used to express the inverse of a typical Restriction, namely the approval of an Option or Added Function.

This information is stored under the `era:CertificationLevelDocument`'s `era:CABAssessmentCheck` like shown in the example."""@en .


###  http://data.europa.eu/949/CABAssessmentCheck
era:CABAssessmentCheck rdf:type owl:Class ;
                       rdfs:subClassOf era:Compliance ;
                       owl:disjointWith era:CABAuditCheck ;
                       era:usedInEradis true ;
                       dcterms:created "2025-07-18"^^xsd:date ;
                       rdfs:comment "A compliance check as executed by a Conformity Assessment Body. The class can be used NoBo, DeBo and/or AsBo checks."@en ;
                       rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                       rdfs:label "CAB Assessment Check"@en ;
                       rdfs:seeAlso "https://nb-rail.eu/official-documents"^^xsd:anyURI ;
                       vs:term_status "stable" ;
                       skos:scopeNote """This class is used to model the compliance details, typically of a era:CertificationLevelDocument (through `vpa:checkedCompliance`):
- [Scope of /Exemptions from Assessment], using the property `era:complianceResult` and a reference to the TSI or Section which was in scope or exempted;
- Assessment result can be documented using standard ontology properties."""@en .


###  http://data.europa.eu/949/CABAuditCheck
era:CABAuditCheck rdf:type owl:Class ;
                  rdfs:subClassOf era:Compliance ;
                  era:usedInEradis true ;
                  dcterms:created "2025-07-18"^^xsd:date ;
                  rdfs:comment "A compliance observation as executed by a Conformity Assessment Body in an audit. The class can be used NoBo, DeBo and/or AsBo checks."@en ;
                  rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                  rdfs:label "CAB Audit Check"@en ;
                  rdfs:seeAlso "https://nb-rail.eu/official-documents"^^xsd:anyURI ;
                  vs:term_status "stable" ;
                  skos:scopeNote """This class is used to model the audit observations of a era:CertificationLevelDocument (through `vpa:checkedCompliance`):
- [Scope of /Exemptions from Audit], using the property `era:complianceResult` and a reference to the TSI or Section which was in scope or exempted;
- Audit result can be documented using standard ontology properties."""@en .


###  http://data.europa.eu/949/CABCertificate
era:CABCertificate rdf:type owl:Class ;
                   rdfs:subClassOf vpa:EvidenceDocument ;
                   dcterms:created "2026-01-09"^^xsd:date ;
                   rdfs:comment "A `vpa:EvidenceDocument` from a Conformity Assessment Body examining any other reference than a TSI or its annexes."@en ;
                   rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                   vs:term_status "stable" ;
                   rdfs:label "Certificate from a CAB"@en ;
                   skos:scopeNote """In order to distinguish between `EC Certificates` (which are a subset of `era:CertificationLevelDocument`) and more general `Certificates of Conformity`
as delivered for any other conformity check towards annexes of Directives, also outside of the railway system."""@en .


###  http://data.europa.eu/949/CABEvidence
era:CABEvidence rdf:type owl:Class ;
                rdfs:subClassOf era:DocumentSet ;
                dcterms:created "2026-01-09"^^xsd:date ;
                rdfs:comment "A `era:DocumentSet` which mainly contains Certification Level Documents or Certificates of Conformity from a Conformity Assessment Body."@en ;
                rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                rdfs:label "Evidence from a CAB"@en ;
                vs:term_status "stable" .

###  http://data.europa.eu/949/CABRestriction
era:CABRestriction rdf:type owl:Class ;
                   rdfs:subClassOf era:Restriction ;
                   era:usedInEradis true ;
                   dcterms:created "2025-07-18"^^xsd:date ;
                   rdfs:comment "A Restriction which was issued by a CAB"@en ;
                   rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                   rdfs:label "CAB restriction"@en ;
                   rdfs:seeAlso "https://nb-rail.eu/official-documents"^^xsd:anyURI ;
                   vs:term_status "stable" ;
                   skos:example """era-cld:cld-NoBoCert-25403 a era:CertificationLevelDocument , vpa:EvidenceDocument ;
  vpa:checkedCompliance [
    # Assessment Requirements regarding TSI.
    a era:CABAssessmentCheck ;
    vpa:checkedRequirement eralex:cir-2016-919, eralex:cir-2019-776, eralex:cir-2020-387, eralex:cir-2020-420 ;
  ] , [
    a era:CABAssessmentCheck ;
    era:isOptional "true"^^xsd:boolean ;
    era:complianceResult era-compliance:FullyCompliant ;
    vpa:withRestriction [
      a era:CABRestriction;
      dcterms:type era-cld-restriction-types:Option ;              # WARNING, SKOS Concept scheme only in version 4.0.0+
      dcterms:description "{Describe the restriction here}"
      era:nonCodedRestrictions "{Conditions and Limits of Use regarding this Optional Function}"@en ;
      dcterms:source era-cld-additional-function-reasons:R4     # WARNING, SKOS Concept scheme only in version 4.0.0+
    ]
  ].
""" ;
                   skos:scopeNote """This class is used to express a Restriction, as formulated by a CAB.

This information is stored under the `era:CertificationLevelDocument`'s `era:CABAssessmentCheck` like shown in the example."""@en .

###  http://data.europa.eu/949/Certificate
era:Certificate rdf:type owl:Class ;
                rdfs:subClassOf vpa:Permission ;
                dcterms:created "2022-06-15"^^xsd:date ;
                dcterms:modified "2022-06-15"^^xsd:date ,
                                 "2024-10-24"^^xsd:date ,
                                 "2025-04-04"^^xsd:date ;
                dcterms:source <http://data.europa.eu/eli/dir/2016/797/2020-05-28> ,
                <http://data.europa.eu/eli/dir/2016/798/2020-10-23> ;
                rdfs:comment "Base class for those Certificates in the ERADIS register, which allow a IOD/SD described process."@en ;
                rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                rdfs:label "Certificate"@en ;
                vs:term_status "stable" ;
                owl:deprecated "false"^^xsd:boolean ;
                skos:scopeNote """In the context of the ERA vocabulary, a Certificate (`vpa:Permission`) can be:
- Safety Certificate (`vpa:grantedBy` NSA, `vpa:requestedBy` RailwayUndertaking), permitting 'access to the railway infrastructure' (SD Art. 10).
- Safety Authorisation (`vpa:grantedBy` NSA, `vpa:requestedBy` InfrastructureManager), permitting 'to manage and operate a rail infrastructure' (SD Art.12)
- Licence for the performance of rail transport services within the Union and the European Economic Area
- ECM Certificates, permitting to act as an ECM
- ...

Note: The `Interoperability documents` in ERADIS must use other Classes:
- EC DoV, EC DoC, EC DoSoU are issued by Applicants (use `era:ECDeclaration`);
- CLD's are issued by NoBo's (use `era:CLD`)"""@en .


###  http://data.europa.eu/949/CertificationLevelDocument
era:CertificationLevelDocument rdf:type owl:Class ;
                               rdfs:subClassOf vpa:EvidenceDocument ;
                               owl:disjointWith era:ECDeclaration ;
                               era:usedInEradis true ;
                               dcterms:created "2025-04-04"^^xsd:date ;
                               dcterms:modified "2025-11-23"^^xsd:date ;
                               rdfs:comment "Certification Level Document, as issued by a NoBo in the process of its certification/verification activities [RFU-STR-001]. The class can be reused as well for DeBo and AsBo certificates."@en ;
                               rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                               rdfs:label "Certification Level Document"@en ;
                               rdfs:seeAlso "https://nb-rail.eu/official-documents"^^xsd:anyURI ;
                               vs:term_status "stable" ;
                               skos:altLabel "CLD"@en ;
                               skos:scopeNote """Every CLD is the result of a process by a recognised/accredited body (`vpa:AppropriateBody`) which is allowed to issue it to a `vpa:RequestingBody` needing it for a specific purpose,
as defined in the IOD or SD. Several CLDs can support EC Declarations."""@en .

###  http://data.europa.eu/949/CommonCharacteristicsSubset
era:CommonCharacteristicsSubset rdf:type owl:Class ;
                                rdfs:subClassOf era:Feature ;
                                era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/CommonCharacteristicsSubsetShape> ;
                                dcterms:created "2022-11-04"^^xsd:date ;
                                dcterms:modified "2023-03-14"^^xsd:date ,
                                                 "2024-10-31"^^xsd:date ,
                                                 "2025-08-26"^^xsd:date ,
                                                 "2026-01-11"^^xsd:date ;
                                rdfs:comment "A set of different infrastructure objects sharing the same common technical characteristics. The parameters may not be restricted to only one railway subsystem, but it can include common characteristics from each one of them (infrastructure, energy, track-side CCS)"@en ;
                                rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                rdfs:label "Subset with common characteristics"@en ;
                                vs:term_status "stable" .


###  http://data.europa.eu/949/Compliance
era:Compliance rdf:type owl:Class ;
               rdfs:subClassOf vpa:Compliance ;
               dcterms:created "2025-07-18"^^xsd:date ;
               rdfs:comment "A Compliance result, having its origin in a railway verification/certification/assessment process."@en ;
               rdfs:isDefinedBy <http://data.europa.eu/949/> ;
               rdfs:label "Compliance"@en .


###  http://data.europa.eu/949/ContactLineSystem
era:ContactLineSystem rdf:type owl:Class ;
                      era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ContactLineSystemShape> ;
                      dcterms:created "2021-08-04"^^xsd:date ;
