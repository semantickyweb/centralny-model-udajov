                      vs:term_status "stable" .


###  http://data.europa.eu/949/Document
era:Document rdf:type owl:Class ;
             rdfs:subClassOf foaf:Document ;
             era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/DocumentShape> ;
             dcterms:created "2024-04-23"^^xsd:date ;
             rdfs:comment "Document in any of the ERA systems, e.g. reference document in RINF."@en ;
             rdfs:isDefinedBy <http://data.europa.eu/949/> ;
             rdfs:label "ERA Document"@en ;
             vs:term_status "stable" .

###  http://data.europa.eu/949/DocumentSet
era:DocumentSet rdf:type owl:Class ;
                rdfs:subClassOf vpa:Evidence ;
                dcterms:created "2025-02-19"^^xsd:date ;
                dcterms:modified "2025-02-21"^^xsd:date ;
                rdfs:comment "A collection of documents belonging together, as they contain - as a set - evidence in an ERA process like registration or authorisation."@en ;
                rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                rdfs:label "Application Document Set"@en ;
                vs:term_status "stable" .

###  http://data.europa.eu/949/ECDeclaration
era:ECDeclaration rdf:type owl:Class ;
                  rdfs:subClassOf vpa:EvidenceDocument ;
                  dcterms:created "2025-04-04"^^xsd:date ;
                  dcterms:source <https://eur-lex.europa.eu/eli/dir/2016/797/2020-05-28#art_10> ,
                  <https://eur-lex.europa.eu/eli/dir/2016/797/2020-05-28#art_15> ,
                  <https://eur-lex.europa.eu/eli/dir/2016/797/2020-05-28#art_9> ;
                  rdfs:comment "EC Declaration of Verification/Conformity/Suitability for Use, as issued by an Applicant in the process of certification/verification activities for IC's or subsystems."@en ;
                  rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                  rdfs:label "EC Declaration of Verification/Conformity"@en ;
                  rdfs:seeAlso "https://nb-rail.eu/official-documents"^^xsd:anyURI ;
                  vs:term_status "stable" ;
                  skos:scopeNote """Every EC Declaration is the outcome of a process assisted by a recognised/accredited body (`vpa:AppropriateBody`) which is allowed to issue the supporting
CLD's to the `vpa:RequestingBody` needing it for a specific purpose, as defined in the IOD or SD.
EC Declarations MUST refer to the required CLDs using `dcterms:requires` which can be grouped as `vpa:Evidence` in authorisation/registration processes."""@en .


###  http://data.europa.eu/949/ERTMSErrorChangeRequest
era:ERTMSErrorChangeRequest rdf:type owl:Class ;
                            rdfs:subClassOf skos:Concept ;
                            dcterms:created "2026-03-16"^^xsd:date ;
                            dcterms:modified "2026-03-16"^^xsd:date ;
                            rdfs:isDefinedBy era: ;
                            rdfs:label "ERTMS error change request"@en ;
                            rdfs:comment "SKOS concept representing a change request (CR) classified as an error in the ERTMS specifications and analysed by the Agency to identify whether it may prevent the system from providing normal service under Article 10 of the CCS TSI."@en ;
                            vs:term_status "stable" .


###  http://data.europa.eu/949/ETCS
era:ETCS rdf:type owl:Class ;
         era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ETCSShape> ;
         dcterms:created "2021-08-07"^^xsd:date ;
         dcterms:modified "2021-08-07"^^xsd:date ;
         rdfs:comment "TSI compliant train protection system ERTMS / ETCS application level and baseline related to the track side equipment."@en ;
         rdfs:isDefinedBy <http://data.europa.eu/949/> ;
         rdfs:label "ETCS"@en ;
         vs:term_status "stable" .


###  http://data.europa.eu/949/Feature
era:Feature rdf:type owl:Class ;
            rdfs:subClassOf gsp:Feature ;
            owl:disjointWith era:TemporalFeature ;
            era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/FeatureShape> ;
            dcterms:created "2022-07-07"^^xsd:date ;
            dcterms:modified "2022-10-27"^^xsd:date ;
            rdfs:comment "Class that encompasses the features that are part of the physical infrastructure (class InfrastructureElement) and the topological objects (class TopologicalObject). It is a subclass of the geographical Feature class that has a spatial representation."@en ;
            rdfs:isDefinedBy <http://data.europa.eu/949/> ;
            rdfs:label "ERA Feature"@en .


###  http://data.europa.eu/949/FrenchTrainDetectionSystemLimitation
era:FrenchTrainDetectionSystemLimitation rdf:type owl:Class ;
                                         era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/FrenchTrainDetectionSystemLimitationShape> ;
                                         dcterms:created "2023-04-05"^^xsd:date ;
                                         rdfs:comment "Specific for route compatibility check on French network."@en ;
                                         rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                         rdfs:label "Section with train detection limitation"@en ;
                                         vs:term_status "stable" .


