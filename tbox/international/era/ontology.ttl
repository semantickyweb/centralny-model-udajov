                                                      ]
                                                    )
                             ] ;
                  era:applicable "Y/N/NYA" ;
                  era:dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
                  era:formatNote "NNF, with N a decimal number (0 9), NNF must be divisible by 5, so F=(0|5), max. `600`" ;
                  era:legalDeadline "12 months after publication of Article 7 Guide"@en ;
                  era:rinfIndex "1.1.1.3.2.16.3" ,
                                "1.2.1.1.1.16.3" ;
                  era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/VNvallowovtrp> ,
                                               <http://data.europa.eu/949/shapes/VNvallowovtrpApplicability> ;
                  era:tsiOPEAppendixD3Index "1.5.3" ;
                  era:unitOfMeasure unit:KiloM-PER-HR ;
