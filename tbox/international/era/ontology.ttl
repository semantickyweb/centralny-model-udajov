:gsmrNetworkCoverage :dependencyNote "GSM-R must be installed for this parameter to be applicable"@en .

:idPhoneErtmsRadioBlockCenter :dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en .

