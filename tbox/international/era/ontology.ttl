:Track owl:disjointWith :Tunnel .

:RunningTrack owl:disjointWith :Tunnel, :Signal, :Siding, :Switch .

:LinearElement owl:disjointWith :NonLinearElement .

:VehicleType owl:disjointWith :VehicleTypeConfigParameterSet, :VehicleTypeConfiguration,
    :VehicleSet .

:OperationalPoint owl:disjointWith :Track, :Tunnel, :Signal, :PrimaryLocation, :SectionOfLine,
    :PlatformEdge, :RadioBlockCenter, :SpecialArea, :Switch .

:NetElement owl:disjointWith :NetRelation .

:KilometricPost owl:disjointWith :Track, :OperationalPoint, :Tunnel, :Signal, :PrimaryLocation,
    :SectionOfLine, :PlatformEdge, :RadioBlockCenter, :SpecialArea, :LevelCrossing, :Switch .

:LinearPositioningSystem owl:disjointWith :LinearPositioningSystemCoordinate .

:Signal owl:disjointWith :Track, :Tunnel, :SpecialArea, :Switch .

:HABD owl:disjointWith :Track, :OperationalPoint, :Tunnel, :KilometricPost, :Signal,
    :PrimaryLocation, :SectionOfLine, :PlatformEdge, :RadioBlockCenter, :SpecialArea,
    :LevelCrossing, :Switch .

:PrimaryLocation owl:disjointWith :Track, :SubsidiaryLocation, :Tunnel, :Signal, :SectionOfLine,
    :RadioBlockCenter, :SpecialArea, :Switch .

:SectionOfLine owl:disjointWith :Track, :Tunnel, :Signal, :SpecialArea, :Switch .

:Vehicle owl:disjointWith :VehicleType .

:Siding owl:disjointWith :Tunnel, :Signal, :Switch .

:PlatformEdge owl:disjointWith :Track, :RunningTrack, :Tunnel, :Signal, :PrimaryLocation,
    :SectionOfLine, :Siding, :RadioBlockCenter, :SpecialArea, :Switch .

:RadioBlockCenter owl:disjointWith :Track, :Tunnel, :Signal, :SectionOfLine, :SpecialArea,
    :Switch .

:Body owl:disjointWith :InfrastructureElement, :OrganisationRole .

:SpecialArea owl:disjointWith :Track, :Tunnel, :Switch .

:Feature owl:disjointWith :TemporalFeature .

:Bridge owl:disjointWith :Track, :RunningTrack, :OperationalPoint, :Tunnel, :KilometricPost,
    :Signal, :HABD, :PrimaryLocation, :SectionOfLine, :Siding, :PlatformEdge, :RadioBlockCenter,
    :SpecialArea, :LevelCrossing, :Switch .

:LevelCrossing owl:disjointWith :Track, :RunningTrack, :OperationalPoint, :Tunnel,
    :Signal, :PrimaryLocation, :SectionOfLine, :Siding, :PlatformEdge, :RadioBlockCenter,
    :SpecialArea, :Switch .

:Switch owl:disjointWith :Track, :Tunnel .

:VehicleTypeConfigParameterSet owl:disjointWith :VehicleTypeConfiguration, :VehicleSet .

:VehicleTypeConfiguration owl:disjointWith :VehicleSet .

:VehicleRegistrationCheck owl:disjointWith :VehicleTypeAuthorisationCheck .

