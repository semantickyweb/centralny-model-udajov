                    rdfs:subPropertyOf era:ccsSubsystemDeclarationsVerificationTrackDataParameter ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( era:CommonCharacteristicsSubset
                                                era:RunningTrack
                                                era:VehicleRegistrationCase
                                              )
