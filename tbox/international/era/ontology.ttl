                                era:legalDeadline "1 January 2021"@en ,
                                                  "12 months after publication of Article 7 Guide for OP tracks"@en ;
                                era:rinfIndex "1.1.1.3.3.7" ,
                                              "1.2.1.1.2.7" ;
                                era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/PublicNetworkRoamingDetails> ,
                                                             <http://data.europa.eu/949/shapes/PublicNetworkRoamingDetailsApplicability> ;
