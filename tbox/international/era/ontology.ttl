                                         "2024-11-29"^^xsd:date ;
                        rdfs:comment """Railway line within a member state.
A line is a sequence of one or more sections of line, which connects operational points and which may consist of several tracks used for regular railway operation."""@en ;
                        rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                        rdfs:label "(deprecated) National railway line"@en ;
                        owl:deprecated "true"^^xsd:boolean ;
                        vs:term_status "stable" .


###  http://data.europa.eu/949/NetAreaReference
era:NetAreaReference rdf:type owl:Class ;
                     rdfs:subClassOf era:NetBasicReference ;
                     era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/NetAreaReferenceShape> ;
                     dcterms:created "2024-11-29"^^xsd:date ;
                     rdfs:comment "Represents an area reference in the network."@en ;
                     rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                     rdfs:label "Net Area Reference"@en ;
                     skos:example "Example: non-stopping area, cross section area, area of implementation of GPRS etc."@en ;
                     skos:scopeNote "It is used for infrastructure elements positioned in relation to the topology as a subnetwork. (e.g.: tunnels, non-stopping area, stations etc.)"@en .


###  http://data.europa.eu/949/NetBasicReference
era:NetBasicReference rdf:type owl:Class ;
                      rdfs:subClassOf era:Feature ;
                      era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/NetBasicReferenceShape> ;
                      dcterms:created "2024-11-29"^^xsd:date ;
                      rdfs:comment "Basic positioning reference within the ERA ontology. It represents different types of geographical locations. Geographical coordinates are provided according to the standard World Geodetic System (WGS84)."@en ;
                      rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                      rdfs:label "Net Basic Reference"@en ;
                      rdfs:seeAlso "https://wiki.railtopomodel.org/wiki/Object_positioning_in_the_network"^^xsd:anyURI ;
                      skos:scopeNote ""@en .


###  http://data.europa.eu/949/NetElement
era:NetElement rdf:type owl:Class ;
               rdfs:subClassOf era:Feature ;
               owl:disjointWith era:NetRelation ;
               era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/NetElementShape> ;
               dcterms:created "2024-11-29"^^xsd:date ;
               dcterms:modified "2025-04-30"^^xsd:date ;
               rdfs:comment "It is a representation of all building blocks of the topology. It references an associated topological network element."@en ;
               rdfs:isDefinedBy <http://data.europa.eu/949/> ;
               rdfs:label "Net element"@en ;
               rdfs:seeAlso "https://wiki.railtopomodel.org/wiki/Topological_structure_(network)"^^xsd:anyURI .


###  http://data.europa.eu/949/NetLinearReference
era:NetLinearReference rdf:type owl:Class ;
                       rdfs:subClassOf era:NetBasicReference ;
                       era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/NetLinearReferenceShape> ;
                       dcterms:created "2024-11-29"^^xsd:date ;
                       rdfs:comment "Represents a linear reference in the network."@en ;
                       rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                       rdfs:label "Net Linear Reference"@en ;
                       skos:example "Example: tracks, tunnels, bridges, platform edges etc."@en ;
                       skos:scopeNote "It is used for infrastructure elements positioned in relation to the topology as a line, or along a path. (e.g.: tracks, bridges, platform edges, etc.)"@en .


###  http://data.europa.eu/949/NetPointReference
era:NetPointReference rdf:type owl:Class ;
                      rdfs:subClassOf era:NetBasicReference ;
                      era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/NetPointReferenceShape> ;
                      dcterms:created "2024-11-29"^^xsd:date ;
                      rdfs:comment "Represents a point reference in the network."@en ;
                      rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                      rdfs:label "Net Point Reference"@en ;
                      skos:scopeNote "It is used for infrastructure elements positioned in relation to the topology as a point. (e.g.: signals, ETCS balises, buffer stops, etc.)"@en .


###  http://data.europa.eu/949/NetRelation
era:NetRelation rdf:type owl:Class ;
                rdfs:subClassOf era:Feature ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty era:elementA ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass era:LinearElement
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty era:elementB ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass era:LinearElement
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty era:navigability ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass skos:Concept
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty era:isOnOriginOfElementA ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:boolean
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty era:isOnOriginOfElementB ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:boolean
                                ] ;
                era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/NetRelationShape> ;
                dcterms:created "2024-11-29"^^xsd:date ;
                dcterms:modified "2025-03-10"^^xsd:date ,
                                 "2025-11-21"^^xsd:date ;
                rdfs:comment "Defines a relation between two elements."@en ;
                rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                rdfs:label "Net Relation"@en ;
                rdfs:seeAlso "https://wiki.railtopomodel.org/wiki/Topological_structure_(network)"^^xsd:anyURI ;
                skos:scopeNote """Connectivity and the navigability between consecutive linear elements are resolved by using net relations. It models how different elements are related to each other, representing a transition from one element to another. 
Net relations specify where two linear elements connect. This could be at the origin of one element, the end of another, or even at specific offsets along their lengths. For example, two tracks might connect at a junction, with one ending at offset 1500 and the other beginning at offset 0. 
NetRelation explicitly models these connections by linking two linear elements (elementA and elementB) and defining their physical or logical relationship.
Net relations also specify the permitted directions of travel:
•	AB: Trains can move from element A to element B.
•	BA: Trains can move from element B to element A.
•	Both: Movement is bidirectional.
•	None: No movement is allowed between the two elements.
To make this even more precise, net relations include information about whether the connection is at the origin of each element. For example, a relation might indicate that Track A ends at its origin (offset 0) and connects to Track B at its start (isOnOriginOfElementA and isOnOriginOfElementB).
"""@en .


###  http://data.europa.eu/949/NonLinearElement
era:NonLinearElement rdf:type owl:Class ;
                     rdfs:subClassOf era:NetElement ;
                     era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/NonLinearElementShape> ;
                     dcterms:created "2024-11-29"^^xsd:date ;
                     rdfs:comment "Represents a non-linear element in the network."@en ;
                     rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                     rdfs:label "Non-Linear Element"@en ;
                     skos:scopeNote "Non-linear elements complement the linear structure by serving as connection or interaction points. They represent features such as stations, depots, or complex junctions. They often serve as aggregation points for linear elements, where multiple tracks meet or like logical entities that support operations like passenger boarding or train storage. These elements may optionally aggregate linear elements."@en .


###  http://data.europa.eu/949/OperationalPoint
era:OperationalPoint rdf:type owl:Class ;
                     rdfs:subClassOf era:InfrastructureElement ;
                     owl:disjointWith era:PlatformEdge ,
                                      era:PrimaryLocation ,
                                      era:RadioBlockCenter ,
                                      era:SectionOfLine ,
                                      era:Signal ,
                                      era:SpecialArea ,
                                      era:Switch ,
                                      era:Track ,
                                      era:Tunnel ;
                     era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/OperationalPointShape> ;
                     dcterms:created "2020-07-29"^^xsd:date ;
                     dcterms:modified "2022-07-07"^^xsd:date ,
                                      "2025-01-30"^^xsd:date ,
                                      "2025-03-01"^^xsd:date ;
                     rdfs:comment "An operational point (OP) means any location for train service operations, where train services may begin and end or change route, and where passenger or freight services may be provided; operational point also means any location at boundaries between Member States or infrastructure managers."@en ;
                     rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                     rdfs:label "Operational Point"@en ;
                     vs:term_status "stable" .


###  http://data.europa.eu/949/OrganisationRole
era:OrganisationRole rdf:type owl:Class ;
                     era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/OrganisationRoleShape> ;
                     rdfs:comment "Represents an n-ary relationship between a Body and a role"@en ;
                     rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                     rdfs:label "Organisation Role"@en .


###  http://data.europa.eu/949/Orientation
era:Orientation rdf:type owl:Class ;
                era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/OrientationShape> ;
                rdfs:comment "Represents the orientation of a railway object in relation to a carrier linear element. It can be described by direction, orientation and side."@en ;
                rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                rdfs:label "Orientation"@en .


###  http://data.europa.eu/949/ParameterApplicability
era:ParameterApplicability rdf:type owl:Class ;
                           rdfs:subClassOf era:TemporalFeature ;
                           era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ParameterApplicabilityShape> ;
                           dcterms:modified "2024-10-28"^^xsd:date ;
                           rdfs:comment "Applicability interval defines the date interval in which a characteristic of an infrastructure element is applicable. This interval can be applied for any of the technical characteristics or general information of infrastructure elements. This helps identifying planned changes applied to technical parameters over time."@en ;
                           rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                           rdfs:label "Parameter applicability"@en .

###  http://data.europa.eu/949/PermissiblePayload
era:PermissiblePayload rdf:type owl:Class ;
                       rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                       era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/PermissiblePayloadShape> ;
                       rdfs:label "Permissible Payload"@en .

###  http://data.europa.eu/949/PhaseInfo
era:PhaseInfo rdf:type owl:Class ;
              era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/PhaseInfoShape> ;
              dcterms:created "2023-04-05"^^xsd:date ;
              dcterms:modified "2025-02-18"^^xsd:date ;
              dcterms:replaces era:phaseInfo ;
              rdfs:comment "Indication of required several information on phase separation."@en ;
              rdfs:isDefinedBy <http://data.europa.eu/949/> ;
              rdfs:label "Phase info"@en ;
              vs:term_status "stable" .


###  http://data.europa.eu/949/PlatformEdge
era:PlatformEdge rdf:type owl:Class ;
                 rdfs:subClassOf era:InfrastructureElement ;
                 owl:disjointWith era:PrimaryLocation ,
                                  era:RadioBlockCenter ,
                                  era:RunningTrack ,
                                  era:SectionOfLine ,
                                  era:Siding ,
                                  era:Signal ,
                                  era:SpecialArea ,
                                  era:Switch ,
                                  era:Track ,
                                  era:Tunnel ;
                 era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/PlatformEdgeShape> ;
                 dcterms:created "2021-08-02"^^xsd:date ;
                 dcterms:modified "2023-11-10"^^xsd:date ,
                                  "2025-01-30"^^xsd:date ,
                                  "2025-03-01"^^xsd:date ;
                 rdfs:comment "Platform for the purpose of RINF is understood as a platform edge. A platform concerns only the part of the structure neighbouring to the track (interfaced with trains)."@en ;
                 rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                 rdfs:label "Platform edge"@en ;
                 vs:term_status "stable" .


###  http://data.europa.eu/949/PrimaryLocation
era:PrimaryLocation rdf:type owl:Class ;
                    rdfs:subClassOf era:InfrastructureElement ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty era:netReference ;
                                      owl:allValuesFrom era:NetPointReference
                                    ] ;
                    owl:disjointWith era:RadioBlockCenter ,
                                     era:SectionOfLine ,
                                     era:Signal ,
                                     era:SpecialArea ,
                                     era:SubsidiaryLocation ,
                                     era:Switch ,
                                     era:Track ,
                                     era:Tunnel ;
                    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/PrimaryLocationShape> ;
                    dcterms:modified "2024-10-28"^^xsd:date ,
                                     "2025-03-01"^^xsd:date ,
                                     "2025-06-06"^^xsd:date ;
                    rdfs:comment """Primary Location is a place used by IM to define a path for a train in TAF/TAP TSI framework/messages. This location is a rail point inside the rail network where train starts, ends, stops, or runs through or change line. This location must be managed by an Infrastructure Manager (IM) identified by company code.

Primary locations are identified by single and unique Primary Location codes. Primary location code is allocated based on processes defined by national entity. Primary location codes are used in any kind of TAF/TAP communication.
"""@en ;
                    rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                    rdfs:label "Primary Location"@en ;
                    rdfs:seeAlso "http://taf-jsg.info/wp-content/uploads/2025/07/JSG-Handbook-3.7-with-XSD-3.5.1.0.pdf"^^xsd:anyURI ,
                                 "Handbook 9.3.3 / page 60" ;
                    skos:example "Primary locations are for example: stations, yards, halts, handover points, border points, open access terminals. "@en .


###  http://data.europa.eu/949/RadioBlockCenter
era:RadioBlockCenter rdf:type owl:Class ;
                     rdfs:subClassOf era:InfrastructureElement ;
                     owl:disjointWith era:SectionOfLine ,
                                      era:Signal ,
                                      era:SpecialArea ,
                                      era:Switch ,
                                      era:Track ,
                                      era:Tunnel ;
                     era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/RadioBlockCenterShape> ;
                     dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1693/oj> ;
                     rdfs:comment """ETCS trackside centralised unit controlling ETCS train movements in level 2.

A centralised safety unit that receives train position information via radio and sends movement authorities via radio to trains."""@en ;
                     rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                     rdfs:label "Radio Block Center"@en ;
                     rdfs:seeAlso "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32023R1693&qid=1698394526534"^^xsd:anyURI ,
                                  "https://www.era.europa.eu/system/files/2023-09/index003_-_SUBSET-023_v400.pdf"^^xsd:anyURI .


###  http://data.europa.eu/949/RaisedPantographsDistanceAndSpeed
era:RaisedPantographsDistanceAndSpeed rdf:type owl:Class ;
                                      era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/RaisedPantographsDistanceAndSpeedShape> ;
                                      dcterms:created "2023-04-05"^^xsd:date ;
                                      rdfs:comment """Indication of maximum number of raised pantographs per train allowed and minimum spacing centre line to centre line of adjacent pantograph heads, expressed in metres, at the given speed.
Each track can have several raised pantographs per train allowed (structured) values, and each one has values for number of pantographs, minimum distance between pantographs, in metres, and speed considered in km/h."""@en ;
                                      rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                      rdfs:label "Requirements for number of raised pantographs and spacing between them, at the given speed"@en ;
                                      vs:term_status "stable" ;
                                      skos:scopeNote """This class gives the information about the number of pantographs and the distance between them at a given speed for which the Overhead Contact Line (OCL) has been designed.
As for different speeds different combinations of number of pantographs and distance between them may exist, so this class can be repeated to present all of them."""@en .


###  http://data.europa.eu/949/ReferenceBorderPoint
era:ReferenceBorderPoint rdf:type owl:Class ;
                         rdfs:subClassOf era:Feature ;
                         era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ReferenceBorderPointShape> ;
                         dcterms:created "2024-10-24"^^xsd:date ;
                         dcterms:modifed "2025-02-24"^^xsd:date ;
                         dcterms:replaces era:borderPointOf ,
                                          era:opInfoPerCountry ;
                         rdfs:comment "List of reference border points that are specified in the RINF Application Guide."@en ;
                         rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                         rdfs:label "Reference border point"@en .


###  http://data.europa.eu/949/Restriction
era:Restriction rdf:type owl:Class ;
                rdfs:subClassOf vpa:Restriction ;
                era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/RestrictionShape> ;
                dcterms:created "2025-07-15"^^xsd:date ;
                rdfs:comment "A restriction, condition of use, having its origin in a railway verification/certification/permission process."@en ;
                rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                rdfs:label "Restriction"@en .


###  http://data.europa.eu/949/RunningTrack
era:RunningTrack rdf:type owl:Class ;
                 rdfs:subClassOf era:Track ;
                 owl:disjointWith era:Siding ,
                                  era:Signal ,
                                  era:Switch ,
                                  era:Tunnel ;
                 era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/RunningTrackShape> ;
                 dcterms:created "2020-07-29"^^xsd:date ;
                 dcterms:modified "2022-07-07"^^xsd:date ,
                                  "2024-09-19"^^xsd:date ,
                                  "2024-11-20"^^xsd:date ;
                 rdfs:comment "A running track means any track used for train service movements; passing loops and meeting loops on plain line or track connections only required for train operation are not published"@en ;
                 rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                 rdfs:label "Running track"@en ;
                 vs:term_status "stable" ;
                 skos:scopeNote "There might be more than one track within the Section of Line, so then the whole set of data for track has to be repeated for each track within the SoL."@en .


###  http://data.europa.eu/949/SectionOfLine
era:SectionOfLine rdf:type owl:Class ;
                  rdfs:subClassOf era:InfrastructureElement ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty era:nationalLine ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass era:LinearPositioningSystem
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty era:opEnd ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass era:OperationalPoint
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty era:opStart ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass era:OperationalPoint
                                  ] ;
                  owl:disjointWith era:Signal ,
                                   era:SpecialArea ,
                                   era:Switch ,
                                   era:Track ,
                                   era:Tunnel ;
                  era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/SectionOfLineShape> ;
                  dcterms:created "2021-04-02"^^xsd:date ;
                  dcterms:modified "2022-07-07"^^xsd:date ,
                                   "2024-09-19"^^xsd:date ,
                                   "2025-01-30"^^xsd:date ,
                                   "2025-03-01"^^xsd:date ;
                  dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
                  rdfs:comment "A section of line means the part of line between adjacent operational points and may consist of several tracks."@en ;
                  rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                  rdfs:label "Section Of Line"@en ;
                  vs:term_status "stable" ;
                  skos:scopeNote "Each network shall be described using as many SoLs as necessary. Each SoL   is generated and identified by OP IDs at start and at end. A SoL only belongs to one Line."@en .


###  http://data.europa.eu/949/Siding
era:Siding rdf:type owl:Class ;
           rdfs:subClassOf era:Track ;
           owl:disjointWith era:Signal ,
                            era:Switch ,
                            era:Tunnel ;
           era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/SidingShape> ;
           dcterms:created "2021-08-10"^^xsd:date ;
           dcterms:modified "2022-10-27"^^xsd:date ,
                            "2024-09-19"^^xsd:date ,
                            "2024-11-20"^^xsd:date ;
           dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/2020-06-16> ;
           rdfs:isDefinedBy <http://data.europa.eu/949/> ;
           rdfs:label "Siding"@en ;
           vs:term_status "stable" ;
           skos:definition "Any track(s) within an operational point which is not used for operational routing of a train."@en ;
           skos:scopeNote "Sidings are all those tracks where running trains in service movements ends and which are not used for operational routing of a train."@en .


###  http://data.europa.eu/949/Signal
era:Signal rdf:type owl:Class ;
           rdfs:subClassOf era:InfrastructureElement ;
           owl:disjointWith era:SpecialArea ,
                            era:Switch ,
                            era:Track ,
                            era:Tunnel ;
           era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/SignalShape> ;
           dcterms:created "2021-04-01"^^xsd:date ;
           dcterms:modified "2022-10-27"^^xsd:date ,
                            "2024-09-19"^^xsd:date ,
                            "2025-01-30"^^xsd:date ,
                            "2025-03-01"^^xsd:date ;
           dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/2023-09-28> ;
           rdfs:comment "A railway signal is a visual display device (next to the tracks or via a DMI in the cabin) that conveys instructions or provides advance warning of instructions regarding the driver's authority to proceed."@en ;
           rdfs:isDefinedBy <http://data.europa.eu/949/> ;
           rdfs:label "Signal"@en ;
           rdfs:seeAlso "https://www.era.europa.eu/system/files/2023-09/index003_-_SUBSET-023_v400.pdf"^^xsd:anyURI ;
           vs:term_status "stable" ;
           skos:scopeNote "Apparatus by means of which a conventional visual or acoustic indication is given, generally concerning the movements/movement authorities of railway vehicles."@en .


###  http://data.europa.eu/949/SpecialArea
era:SpecialArea rdf:type owl:Class ;
                rdfs:subClassOf era:InfrastructureElement ;
                owl:disjointWith era:Switch ,
                                 era:Track ,
                                 era:Tunnel ;
                era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/SpecialAreaShape> ;
                dcterms:created "2022-10-27"^^xsd:date ;
                dcterms:modified "2024-04-18"^^xsd:date ,
                                 "2025-03-01"^^xsd:date ;
                dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
                rdfs:comment """Non-stopping Area: Area defined by the Infrastructure Manager where it may not be safe or suitable to stop a train.
Safe Area: Area defined by the Infrastructure Manager where it is safe or suitable to stop and evacuate a train.
Industrial Risk Area: locations where it is dangerous for the driver to step out."""@en ;
                rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                rdfs:label "Special area"@en ;
                vs:term_status "stable" ;
                skos:editorialNote "Cover era-specialareatypes:SpecialAreaTypes when they are not located in Tunnels" ;
                skos:scopeNote """Encompasses all those areas (outside of the operational gauge) or sections (those in tunnels excluded) which influence operation in the gauge itself, such as 
- safe areas, with the location value provided as Kilometric point of the start;
- restricted areas (non-stopping areas or industrial risk locations).

For these areas in tunnels, use era:SpecialTunnelArea.
Their length MUST be expressed using `era:length`."""@en .


###  http://data.europa.eu/949/SpecialTunnelArea
era:SpecialTunnelArea rdf:type owl:Class ;
                      rdfs:subClassOf era:SpecialArea ;
                      era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/SpecialTunnelAreaShape> ;
                      dcterms:created "2022-10-27"^^xsd:date ;
                      dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
                      era:rinfIndex "1.1.1.1.8.12.1" , "1.2.1.0.5.10.1" ; 
                      rdfs:comment """Area or location within a tunnel:
- a safe area: a walkway, evacuation and rescue points, with the location value provided as Kilometric point of the start;
- a restricted area (non-stopping area or industrial risk location in a tunnel);
- an area with special passing protocols"""@en ;
                      rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                      rdfs:label "Special tunnel area"@en ;
                      vs:term_status "stable" ;
                      skos:scopeNote """Their length MUST be expressed using `era:length`."""@en ;
                      skos:editorialNote "Cover special areas as in RINF 1.1.1.1.8/1.2.1.0.5 or other era-specialareatypes:SpecialAreaTypes when they are located in Tunnels"@en .


###  http://data.europa.eu/949/SubsidiaryLocation
era:SubsidiaryLocation rdf:type owl:Class ;
                       rdfs:subClassOf era:Feature ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty era:linkedToPrimaryLocation ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass era:PrimaryLocation
                                       ] ;
                       era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/SubsidiaryLocationShape> ;
                       dcterms:created "2024-05-24"^^xsd:date ;
                       dcterms:modified "2025-03-10"^^xsd:date ;
                       rdfs:comment "Subsidiary location must be linked to a Primary Location and specifies in more detailed way part, attributes, or usage of Primary location. It may be also a non-rail point or a rail point that is not managed by an Infrastructure Manager (IM). It may be defined by entity having company code according to their needs. The Subsidiary location is optional and dependent upon business needs."@en ;
                       rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                       rdfs:label "Subsidiary location"@en ;
                       rdfs:seeAlso "http://taf-jsg.info/wp-content/uploads/2024/01/20231018-JGS-Handbook-3.4-with-XSD-3.4.0.0.pdf"^^xsd:anyURI .


###  http://data.europa.eu/949/Switch
era:Switch rdf:type owl:Class ;
           rdfs:subClassOf era:InfrastructureElement ;
           owl:disjointWith era:Track ,
                            era:Tunnel ;
           era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/SwitchShape> ;
           dcterms:modified "2025-01-30"^^xsd:date ,
                            "2025-03-01"^^xsd:date ;
           dcterms:source <http://data.europa.eu/eli/reg_impl/2019/776/oj> ;
           rdfs:comment "A unit of track comprising two fixed rails (stock rails) and two movable rails (switch rails) used to direct vehicles from one track to another track."@en ;
           rdfs:isDefinedBy <http://data.europa.eu/949/> ;
           rdfs:label "Switch"@en ;
           vs:term_status "stable" .


###  http://data.europa.eu/949/SystemSeparationInfo
era:SystemSeparationInfo rdf:type owl:Class ;
                         era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/SystemSeparationInfoShape> ;
                         dcterms:created "2023-04-05"^^xsd:date ;
                         dcterms:modified "2025-02-18"^^xsd:date ;
                         dcterms:replaces era:systemSeparationInfo ;
                         rdfs:comment "Indication of required several information on system separation."@en ;
                         rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                         rdfs:label "System separation info"@en ;
                         vs:term_status "stable" .

###  http://data.europa.eu/949/TechnicalSpecForInteroperability
era:TechnicalSpecForInteroperability rdf:type owl:Class ;
                                     rdfs:subClassOf vpa:Requirement ;
                                     era:usedInEradis true ;
                                     dcterms:created "2025-07-30"^^xsd:date ;
                                     dcterms:source <https://eur-lex.europa.eu/eli/dir/2016/797/2020-05-28#art_2> ;
                                     rdfs:comment "Technical Specification for Interoperability"@en ;
                                     rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                     rdfs:label "Technical Specification for Interoperability"@en ;
                                     vs:term_status "stable" ;
                                     skos:altLabel "TSI"@en ;
                                     skos:definition "(11) a specification adopted in accordance with Directive 2016/797 by which each subsystem or part of a subsystem is covered in order to meet the essential requirements and ensure the interoperability of the Union rail system."@en ;
                                     skos:note "Resources of class `era:TSI` must link to their `era:IC`'s through `dcterms:hasPart`."@en .


###  http://data.europa.eu/949/TENTCorridor
era:TENTCorridor rdf:type owl:Class ;
                 dcterms:created "2025-11-17"^^xsd:date ;
                 rdfs:comment "Represents the TEN-T network classification of an element, including its network level, type of traffic, and associated European transport corridors."@en ;
                 rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                 rdfs:label "TEN-T Corridor"@en ;
                 vs:term_status "stable" .


###  http://data.europa.eu/949/TemporalFeature
era:TemporalFeature rdf:type owl:Class ;
                    rdfs:subClassOf [ rdf:type owl:Class ;
                                      owl:unionOf ( time:TemporalDuration
                                                    time:TemporalEntity
                                                  )
                                    ] ;
                    dcterms:created "2024-05-24"^^xsd:date ;
                    rdfs:comment "The union of TemporalDuration that represents a time extent and TemporalEntity that represents a temporal interval or instant."@en ;
                    rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                    rdfs:label "Temporal Feature"@en .


###  http://data.europa.eu/949/TopologicalCoordinate
era:TopologicalCoordinate rdf:type owl:Class ;
                          era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/TopologicalCoordinateShape> ;
                          dcterms:created "2024-11-29"^^xsd:date ;
                          rdfs:comment "Represents a topological coordinate."@en ;
                          rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                          rdfs:label "Topological Coordinate"@en .


###  http://data.europa.eu/949/Track
era:Track rdf:type owl:Class ;
          rdfs:subClassOf era:InfrastructureElement ;
          owl:disjointWith era:Tunnel ;
          dcterms:created "2024-11-20"^^xsd:date ;
          dcterms:modified "2025-01-30"^^xsd:date ,
                           "2025-03-01"^^xsd:date ;
          rdfs:comment "A pair of rails over which rail borne vehicles can run."@en ;
          rdfs:isDefinedBy <http://data.europa.eu/949/> ;
          rdfs:label "Track"@en .


###  http://data.europa.eu/949/TrainDetectionSystem
era:TrainDetectionSystem rdf:type owl:Class ;
                         era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/TrainDetectionSystemShape> ;
                         dcterms:created "2021-08-07"^^xsd:date ;
                         dcterms:modified "2021-08-07"^^xsd:date ;
                         rdfs:comment "Safety system used to detect the presence of vehicles on the railway track."@en ;
                         rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                         rdfs:label "Train Detection System"@en ;
                         vs:term_status "stable" .


###  http://data.europa.eu/949/Tunnel
era:Tunnel rdf:type owl:Class ;
           rdfs:subClassOf era:InfrastructureElement ;
           era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/TunnelShape> ;
           dcterms:created "2020-07-29"^^xsd:date ;
           dcterms:modified "2022-07-07"^^xsd:date ,
                            "2024-09-19"^^xsd:date ,
                            "2025-01-30"^^xsd:date ;
           dcterms:source <http://data.europa.eu/eli/reg/2014/1303/2024-01-29> ;
           rdfs:comment "A railway tunnel is an excavation or a construction around the track provided to allow the railway to pass for example higher land, buildings or water."@en ;
           rdfs:isDefinedBy <http://data.europa.eu/949/> ;
           rdfs:label "Tunnel"@en ;
           vs:term_status "stable" ;
           skos:scopeNote """The length of a tunnel is defined as the length of the fully enclosed section, measured at rail level. A tunnel in the context of this TSI is 0.1 km or longer. 
Where certain requirements apply only to longer tunnels, thresholds are mentioned in the relevant clauses."""@en .


###  http://data.europa.eu/949/Vehicle
era:Vehicle rdf:type owl:Class ;
            owl:disjointWith era:VehicleType ;
            rdfs:subClassOf vpa:Scope ;
            era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/VehicleShape> ;
            dcterms:created "2020-11-22"^^xsd:date ;
            dcterms:modified "2020-11-22"^^xsd:date ;
            rdfs:comment "A specific vehicle or wagon able and allowed to operate over railway infrastructure."@en ;
            rdfs:isDefinedBy <http://data.europa.eu/949/> ;
            rdfs:label "Vehicle"@en ;
            vs:term_status "stable" .


###  http://data.europa.eu/949/VehicleAuthorisation
era:VehicleAuthorisation rdf:type owl:Class ;
                         rdfs:subClassOf <https://w3id.org/vpa#Permission> ;
                         dcterms:created "2025-02-24"^^xsd:date ;
                         dcterms:source <https://data.europa.eu/eli/reg/2018/545/art_2/oj/eng#> ;
                         rdfs:comment """(15) the decision issued by the authorising entity based on a reasonable assurance that the applicant and the entities involved in the design,
manufacture, verification and validation of the vehicle have fulfilled their respective obligations and responsibilities in order to ensure conformity with essential
requirements of the applicable legislation or to ensure conformity with the authorised type enabling that the vehicle may be placed on the market and may be used safely in the
area of use according to the conditions for use and other restrictions, when applicable, specified in the vehicle authorisation and in the vehicle type authorisation;"""@en ;
                         rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                         rdfs:label "Vehicle Authorisation for Placing on the Market"@en ;
                         vs:term_status "stable" .


###  http://data.europa.eu/949/VehicleAuthorisationCase
era:VehicleAuthorisationCase rdf:type owl:Class ;
                             rdfs:subClassOf <https://w3id.org/vpa#Case> ;
                             era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/VehicleTypeAuthorisationCaseShape> ;
                             dcterms:created "2026-01-29"^^xsd:date ;
                             dcterms:source <http://data.europa.eu/eli/dir/2008/57/2015-01-01> ;
                             rdfs:comment """The process allowing the vehicle authorisation for placing in service (APIS).

This authorisation case supported a Vehicle Application for APIS and was determined by exactly one set of Vehicles and if available a VehicleType.

For the Authorisation as per EU 2018/545, use era:VehicleTypeAuthorisationCase, which covers all authorisations types under that legislation."""@en ;
                             rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                             rdfs:label "Vehicle APIS Case"@en ;
                             rdfs:seeAlso "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A02008L0057-20150101#tocId27"^^xsd:anyURI ;
                             vs:term_status "stable" ;
                             skos:editorialNote "Class strictly reserved to model APIS of vehicles as registered in EVR before the 2018/545"@en .


###  http://data.europa.eu/949/VehicleAuthorisationNotification
era:VehicleAuthorisationNotification rdf:type owl:Class ;
                                     rdfs:subClassOf <https://w3id.org/vpa#Request> ;
                                     dcterms:created "2025-05-14"^^xsd:date ;
                                     dcterms:source <https://data.europa.eu/eli/reg/2018/545/art_16/oj/eng#> ;
                                     rdfs:comment """The notification, as submitted by the Applicant in line with (EU)2018/545, informs the authorising entity of the vehicle(s set) to be updated according to Article 16.
The notification consists of one case as described in Art. 16 of (EU)2018/545, containing the vehicle type and EVNs, and linking to the required Evidence.

The outcome of the notification process is an added comment in the  `era:VehicleAuthorisation`, if accepted by the Authorising Entity."""@en ;
                                     rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                     rdfs:label "Vehicle Authorisation Notification"@en ;
                                     vs:term_status "unstable" ;
                                     skos:editorialNote "The class could cover for some vehicle-specific updates, belonging to the VehicleType, given the Art. 16 notification process."@en .


###  http://data.europa.eu/949/VehicleKeeper
era:VehicleKeeper rdf:type owl:Class ;
                  rdfs:subClassOf org:Organization ;
                  dcterms:created "2020-11-23"^^xsd:date ;
                  dcterms:isReplacedBy era:Body ,
                                       era:vehicleKeeper ;
                  dcterms:modified "2020-11-23"^^xsd:date ,
                                   "2024-04-18"^^xsd:date ,
                                   "2024-06-03"^^xsd:date ;
                  rdfs:comment """The natural or legal person that, being the owner of a vehicle or having the right to use it,
exploits the vehicle as a means of transport and is registered as such in a vehicle register referred to in Article 47 of (EU)2016/797."""@en ;
                  rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                  rdfs:label "(deprecated) Vehicle Keeper"@en ;
                  owl:deprecated "true"^^xsd:boolean ;
                  vs:term_status "stable" .


###  http://data.europa.eu/949/VehicleRegistrationCheck
era:VehicleRegistrationCheck rdf:type owl:Class ;
                             rdfs:subClassOf era:Compliance ;
                             owl:disjointWith era:VehicleTypeAuthorisationCheck ;
                             dcterms:created "2025-07-18"^^xsd:date ;
                             rdfs:comment """A verification result as executed by a competent body on a section of a legal reference. The check can be optional, positive or negative, and in the latter case, a restriction is expected.

This Class is used to improve the link between verification outcomes and the verified scope of that process, and support its structured documentation.

It must be used in the context of the Vehicle Registration process."""@en ;
                             rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                             rdfs:label "Vehicle Registration Compliance Check"@en ;
                             rdfs:seeAlso "https://eur-lex.europa.eu/eli/dir/2016/797/oj/eng#anx_IV"^^xsd:anyURI ;
                             vs:term_status "stable" .


###  http://data.europa.eu/949/VehicleKeeperMarking
era:VehicleKeeperMarking rdf:type owl:Class ;
                         rdfs:subClassOf era:OrganisationRole ;
                         rdfs:comment "The class used to relate a Vehicle Keeper Marking (VKM) properties for the purpose of the VKM register."@en ;
                         rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                         rdfs:label "Vehicle Keeper Marking"@en ;
                         rdfs:seeAlso "https://eur-lex.europa.eu/legal-content/EN/ALL/?uri=OJ%3AL%3A2012%3A345%3ATOC"^^xsd:anyURI .


###  http://data.europa.eu/949/VehicleRegistration
era:VehicleRegistration rdf:type owl:Class ;
                        rdfs:subClassOf vpa:Permission ;
                        dcterms:created "2025-03-18"^^xsd:date ;
                        dcterms:source <http://data.europa.eu/eli/dec_impl/2018/1614/2018-10-26> ;
                        rdfs:comment """Vehicle Registration serves to ensure traceability of vehicles and their history: vehicles should be registered under a European vehicle number in a vehicle register. Each
member state designated a registration entity responsible for the registering of vehicles and the processing and update of information in relation to vehicles that entity has registered in the European Vehicle Register.

A vehicle registration groups the information for a (set of) vehicle(s) as in Appendix 4 of Commission Implementing Decision (EU) 2018/1614 of 25 October 2018."""@en ;
                        rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                        rdfs:label "Vehicle Registration"@en ;
                        vs:term_status "stable" .


###  http://data.europa.eu/949/VehicleRegistrationApplication
era:VehicleRegistrationApplication rdf:type owl:Class ;
                                   rdfs:subClassOf vpa:Request ;
                                   dcterms:created "2025-03-18"^^xsd:date ;
                                   dcterms:source <http://data.europa.eu/eli/dec_impl/2018/1614/2018-10-26> ;
                                   rdfs:comment """Keepers should fill in an application for registration with the required information (Appendix 4 of EVR Decision).  A keeper shall submit an application for registration through
the European Vehicle Register to a Member State of its choice within the area of use of the vehicle.

A VehicleRegistrationApplication traces the state of this process, links to the RegistrationCase(s), and a registration entity independent of any railway undertaking which
will be responsible for the processing of the applications and updating of data in the European Vehicle Register."""@en ;
                                   rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                   rdfs:label "Application for Vehicle Registration"@en ;
                                   vs:term_status "stable" .


###  http://data.europa.eu/949/VehicleRegistrationCase
era:VehicleRegistrationCase rdf:type owl:Class ;
                            rdfs:subClassOf vpa:Case ;
                            dcterms:created "2025-03-18"^^xsd:date ;
                            dcterms:source <http://data.europa.eu/eli/dec_impl/2018/1614/2018-10-26> ;
                            rdfs:comment """Vehicle Registrations can be created and modified using a specific Registration Case as listed in `3.2.2.   Registration cases` of the EVR Decision.

Each registration case will have as its scope:
- a set of vehicles of which the registration needs creating/updating.
- if present, the authorisation delivered for these vehicles and/or vehicle type to which they belong."""@en ;
                            rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                            rdfs:label "Vehicle Registration Case"@en ;
                            vs:term_status "stable" .


###  http://data.europa.eu/949/VehicleRegistrationRestriction
era:VehicleRegistrationRestriction rdf:type owl:Class ;
                                   rdfs:subClassOf era:Restriction ;
                                   era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/VehicleRegistrationRestrictionShape> ;
                                   dcterms:created "2025-07-15"^^xsd:date ;
                                   rdfs:comment "An `era:Restriction` which originates from a compliance check during the Vehicle's Registration."@en ;
                                   rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                   rdfs:label "Vehicle Registration Restriction"@en .


###  http://data.europa.eu/949/VehicleSeries
era:VehicleSeries rdf:type owl:Class ;
                  rdfs:subClassOf vpa:Scope ,
                                  rdf:Bag ;
                  era:evrIndex "5.4" ;
                  dcterms:created "2025-03-19"^^xsd:date ;
                  dcterms:modified "2026-07-07"^^xsd:date ;
                  dcterms:source <http://data.europa.eu/eli/dec_impl/2018/1614/oj> ;
                  rdfs:comment "Collection of Vehicles belonging together, for instance in the scope of an Authorisation or Registration Case."@en ;
                  rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                  rdfs:label "Series of Vehicles"@en ;
                  vs:term_status "stable" .


###  http://data.europa.eu/949/VehicleType
era:VehicleType rdf:type owl:Class ;
                rdfs:subClassOf <https://w3id.org/vpa#Scope> ;
                owl:disjointWith era:VehicleTypeConfigParameterSet ,
                                 era:VehicleTypeConfiguration ,
                                 era:VehicleSet ;
                era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/VehicleTypeShape> ;
                dcterms:created "2020-07-29"^^xsd:date ;
                dcterms:modified "2020-07-29"^^xsd:date ,
                                 "2024-04-18"^^xsd:date ,
                                 "2024-06-03"^^xsd:date ;
                rdfs:comment """A vehicle type that has been authorized to operate on the EU railway infrastructure. Type means a vehicle type defining the basic design characteristics of the vehicle as covered by a type or design examination certificate described in the relevant verification module.

Basic design characteristics means the parameters that are used to identify the vehicle type as specified in the issued vehicle type authorisation and recorded in the European Register of Authorised Vehicle Types ('ERATV').

The above mentioned certificate should be documented using era:certificate.
"""@en ;
                rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                rdfs:label "Vehicle Type"@en ;
                vs:term_status "stable" .


###  http://data.europa.eu/949/VehicleTypeAuthorisation
era:VehicleTypeAuthorisation rdf:type owl:Class ;
                             rdfs:subClassOf <https://w3id.org/vpa#Permission> ;
                             era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/VehicleTypeAuthorisationShape> ;
                             dcterms:created "2025-02-24"^^xsd:date ;
                             dcterms:source <https://data.europa.eu/eli/reg/2018/545/art_2/oj/eng#> ;
                             rdfs:comment """(16) the decision issued by the authorising entity based on reasonable assurance that the applicant and the entities involved in the design,
manufacture, verification and validation of the vehicle type have fulfilled their obligations and responsibilities in order to ensure conformity with the essential
requirements of the applicable legislation enabling that a vehicle manufactured according to this design may be placed on the market and may be used safely in the
area of use of the vehicle type according to the conditions for use of the vehicle and other restrictions, when applicable, specified in the vehicle type authorisation
and to be applied to all vehicle authorised in conformity to this type;"""@en ;
                             rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                             rdfs:label "Vehicle Type Authorisation"@en ;
                             vs:term_status "stable" .


###  http://data.europa.eu/949/VehicleTypeAuthorisationApplication
era:VehicleTypeAuthorisationApplication rdf:type owl:Class ;
                                        rdfs:subClassOf <https://w3id.org/vpa#Request> ;
                                        era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/PAVA_CC_I_11_b> ,
                                                                     <http://data.europa.eu/949/shapes/VehicleTypeAuthorisationApplicationShape> ;
                                        dcterms:created "2025-02-24"^^xsd:date ;
                                        dcterms:source <https://data.europa.eu/eli/reg/2018/545/art_14/oj/eng#> ;
                                        rdfs:comment """The request, as submitted by the Applicant in line with (EU)2018/545, to allow the vehicle type authorisation and/or the vehicle authorisation for placing on the market.
The application consists of one or more authorisation cases as described in Art. 14 of (EU)2018/545, and for authorisations before the Fourth Railway Package, a HistoricalAuthorisationCase must be used.

The outcome of the application process is a `era:VehicleAuthorisation` or `era:VehicleTypeAuthorisation`."""@en ;
                                        rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                        rdfs:label "Vehicle Type Authorisation Case"@en ;
                                        vs:term_status "stable" .


###  http://data.europa.eu/949/VehicleTypeAuthorisationCase
era:VehicleTypeAuthorisationCase rdf:type owl:Class ;
                                 rdfs:subClassOf <https://w3id.org/vpa#Case> ;
                                 era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/VehicleTypeAuthorisationCaseShape> ;
                                 dcterms:created "2025-02-19"^^xsd:date ;
                                 dcterms:modified "2026-01-29"^^xsd:date ;
                                 dcterms:source <https://data.europa.eu/eli/reg/2018/545/art_14/oj/eng#> ;
                                 rdfs:comment """The process, as selected by the Applicant in line with (EU)2018/545, allowing the vehicle type authorisation and/or the vehicle authorisation for placing on the market.
The type of authorisation cases are described in Art. 14 of (EU)2018/545, and for authorisations before the Fourth Railway Package, a HistoricalAuthorisationCase must be used.

Each authorisation case supports a VehicleTypeAuthorisationApplication and is determined by exactly one VehicleType, and a set of Vehicles, which can be empty in some cases.

For authorisations before the (EU)2018/545 legislation, use `era:VehicleAuthorisationCase."""@en ;
                                 rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                 rdfs:label "Vehicle Type Authorisation Case"@en ;
                                 vs:term_status "stable" .


###  http://data.europa.eu/949/VehicleTypeAuthorisationCheck
era:VehicleTypeAuthorisationCheck rdf:type owl:Class ;
                                  rdfs:subClassOf era:Compliance ;
                                  dcterms:created "2025-02-19"^^xsd:date ;
                                  dcterms:modified "2025-07-18"^^xsd:date ;
                                  rdfs:comment """A verification result as executed by a competent body on a section of a legal reference. The check can be positive or negative, and in the latter case, a restriction is expected.

This Class is used to improve the link between verification outcomes and the verified scope of that process, and support its structured documentation."""@en ;
                                  rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                  rdfs:label "Vehicle Type Authorisation Compliance Check"@en ;
                                  rdfs:seeAlso "https://eur-lex.europa.eu/eli/dir/2016/797/oj/eng#anx_IV"^^xsd:anyURI ;
                                  vs:term_status "stable" .


###  http://data.europa.eu/949/VehicleTypeAuthorisationRestriction
era:VehicleTypeAuthorisationRestriction rdf:type owl:Class ;
                                        rdfs:subClassOf era:Restriction ;
                                        era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/VehicleTypeAuthorisationRestrictionShape> ;
                                        dcterms:created "2025-02-19"^^xsd:date ;
                                        dcterms:modified "2025-07-15"^^xsd:date ;
                                        dcterms:source <https://data.europa.eu/eli/reg/2018/545/art_14/oj/eng#> ;
                                        rdfs:comment """Restrictions, like coded and non-coded conditions for use, to be taken into account in the context of a Vehicle (Type) Authorisation.

The restrictions are recorded by the Authorising Entities, possibly deduced during underlying verification and certification processes by competent bodies, and if possible are documented with a link
to the legal reference and sections therein.

In most cases, the Restriction will be dependent of a VehicleTypeConfiguration."""@en ;
                                        rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                        rdfs:label "Vehicle Type Authorisation Restriction"@en ;
                                        vs:term_status "stable" .


###  http://data.europa.eu/949/VehicleTypeConfigParameterSet
era:VehicleTypeConfigParameterSet rdf:type owl:Class ;
                                  owl:disjointWith era:VehicleTypeConfiguration ,
                                                   era:VehicleSet ;
                                  era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/VehicleTypeConfigParameterSetShape> ;
                                  dcterms:created "2025-02-13"^^xsd:date ;
                                  rdfs:comment "Stub class linking a VehicleTypeConfiguration (`era:forConfiguration`) with parameters of the VehicleType that depend on that configuration."@en ;
                                  rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                  rdfs:label "Vehicle type configuration parameter set"@en .


###  http://data.europa.eu/949/VehicleTypeConfiguration
era:VehicleTypeConfiguration rdf:type owl:Class ;
                             owl:disjointWith era:VehicleSet ;
                             era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/VehicleTypeConfigurationShape> ;
                             dcterms:created "2025-02-13"^^xsd:date ;
                             rdfs:comment "The combination of supported Gauge, Energy Systems and/or CCO Systems for a vehicle type"@en ;
                             rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                             rdfs:label "Vehicle type configuration"@en ;
                             skos:example "1435mm / AC 15kV-16.7Hz / INDUSI I60" ,
                                          "1435mm / DC 3kV / Implementing Regulation (EU) 2019/776 Set_1" .


###  http://data.europa.eu/949/VehicleSet
era:VehicleSet rdf:type owl:Class ;
                rdfs:subClassOf rdf:Bag ,
                                <https://w3id.org/vpa#Scope> ,
                                [
                                    rdf:type owl:Restriction ;
                                    owl:onProperty rdfs:member ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass era:Vehicle
                                ] ;
                dcterms:created "2025-05-14"^^xsd:date ;
                rdfs:comment "A set of vehicles together forming the Scope of a registration/authorisation case or involved as on whole in another process."@en ;
                rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                rdfs:label "Vehicle Set"@en ;
                vs:term_status "stable" .


###  http://data.europa.eu/949/ForbiddenAssessmentConstraint
era:ForbiddenAssessmentConstraint a owl:Class ;
                                  rdfs:subClassOf era:ValidityConstraint ;
                                  rdfs:label "Forbidden assessment constraint"@en ;
                                  rdfs:comment "A validity constraint signalling that the combination of CLD type and assessment module is structurally not permitted under this TSI."@en ;
                                  dcterms:created "2026-02-12"^^xsd:date ;
                                  rdfs:isDefinedBy era: ;
                                  vs:term_status "stable" .


###  http://data.europa.eu/949/MaxDurationConstraint
era:MaxDurationConstraint a owl:Class ;
                          rdfs:subClassOf era:ValidityConstraint , time:DurationDescription ;
                          rdfs:label "Maximum duration constraint"@en ;
                          rdfs:comment "A validity constraint that imposes an upper bound on the CLD validity period. Being a subclass of time:DurationDescription, it uses time:years (and potentially time:months, time:days) to express the maximum allowed duration."@en ;
                          dcterms:created "2026-02-12"^^xsd:date ;
                          rdfs:isDefinedBy era: ;
                          vs:term_status "stable" .


###  http://data.europa.eu/949/UnlimitedValidityConstraint
era:UnlimitedValidityConstraint a owl:Class ;
                                rdfs:subClassOf era:ValidityConstraint ;
                                rdfs:label "Unlimited validity constraint"@en ;
                                rdfs:comment "A validity constraint signalling that the CLD has no expiry — no end date or duration should be specified."@en ;
                                dcterms:created "2026-02-12"^^xsd:date ;
                                rdfs:isDefinedBy era: ;
                                vs:term_status "stable" .


###  http://data.europa.eu/949/ValidityConstraint
era:ValidityConstraint a owl:Class ;
                       rdfs:label "Validity constraint"@en ;
                       rdfs:comment "Abstract superclass for constraints on CLD validity periods, as prescribed by a TSI or Decision 2010/713/EU."@en ;
                       dcterms:created "2026-02-12"^^xsd:date ;
                       rdfs:isDefinedBy era: ;
                       vs:term_status "stable" .

### ERADIS+ disjoint rule
[] a owl:AllDisjointClasses ;
   owl:members ( era:MaxDurationConstraint
                 era:UnlimitedValidityConstraint
                 era:ForbiddenAssessmentConstraint ) .


###  http://www.opengis.net/ont/geosparql#Feature
gsp:Feature rdf:type owl:Class ;
            rdfs:label "Feature"@en .


###  http://www.opengis.net/ont/geosparql#Geometry
gsp:Geometry rdf:type owl:Class ;
             era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/GeometryShape> ;
             rdfs:label "Geometry"@en .


###  http://www.opengis.net/ont/sf#Point
sf:Point rdf:type owl:Class ;
         rdfs:label "Point"@en .


###  http://www.w3.org/1999/02/22-rdf-syntax-ns#Bag
rdf:Bag rdf:type owl:Class ;
        rdfs:label "Bag"@en .


###  http://www.w3.org/1999/02/22-rdf-syntax-ns#List
rdf:List rdf:type owl:Class ;
         rdfs:label "List"@en .


###  http://www.w3.org/2004/02/skos/core#Concept
skos:Concept rdf:type owl:Class ;
             rdfs:label "Concept"@en .


###  http://www.w3.org/2006/time#Instant
time:Instant rdf:type owl:Class ;
             rdfs:label "Time instant"@en .


###  http://www.w3.org/2006/time#TemporalDuration
time:TemporalDuration rdf:type owl:Class ;
                      rdfs:label "Temporal duration"@en .


###  http://www.w3.org/2006/time#TemporalEntity
time:TemporalEntity rdf:type owl:Class ;
                    rdfs:label "Temporal entity"@en .


###  http://www.w3.org/ns/org#Organization
org:Organization rdf:type owl:Class ;
                 rdfs:label "Organisation"@fr ,
                            "Organization"@en ,
                            "Organizzazione"@it ,
                            "organización"@es .


###  http://www.w3.org/ns/prov#Activity
prov:Activity rdf:type owl:Class ;
              rdfs:label "Activity"@en .


###  http://xmlns.com/foaf/0.1/Document
foaf:Document rdf:type owl:Class ;
              rdfs:label "Document"@en .


###  http://xmlns.com/foaf/0.1/Person
foaf:Person rdf:type owl:Class ;
            rdfs:label "Person"@en .


###  https://w3id.org/vpa#Case
<https://w3id.org/vpa#Case> rdf:type owl:Class ;
                            rdfs:comment "A clearly separated part of a Request, identified clearly by its Scope(s). Each Case has an individual PermissionType as objective. A Request consists out of minimally one Case."@en ;
                            rdfs:label "Case"@en .


###  https://w3id.org/vpa#Compliance
<https://w3id.org/vpa#Compliance> rdf:type owl:Class ;
                                  rdfs:comment "Regroups the result of a compliance check on a specific section of an applicable Requirement as registered in Documented Evicence. If needed, links this examined section to a specific Restriction."@en ;
                                  rdfs:label "Compliance"@en .


###  https://w3id.org/vpa#Evidence
<https://w3id.org/vpa#Evidence> rdf:type owl:Class ;
                                rdfs:label "Evidence"@en .


###  https://w3id.org/vpa#EvidenceDocument
<https://w3id.org/vpa#EvidenceDocument> rdf:type owl:Class ;
                                        rdfs:subClassOf foaf:Document ;
                                        rdfs:comment "Issued by an AppropriateBody, it is the summary of its formal and accredited verification process, enabling the receiver (RequestingBody) to issue a Request for a Permission to the PermittingBody."@en ;
                                        rdfs:label "Evidence Document"@en .


###  https://w3id.org/vpa#Permission
<https://w3id.org/vpa#Permission> rdf:type owl:Class ;
                                  rdfs:comment "Issued by a PermittingBody, it enables - mostly because of legal frameworks in place - the RequestingBody to execute the processes covered under these requirement frameworks."@en ;
                                  rdfs:label "Permission"@en .


###  https://w3id.org/vpa#Request
<https://w3id.org/vpa#Request> rdf:type owl:Class ;
                               rdfs:comment "Issued by a Requesting Body to a PermittingBody, and supported by at least one Case, while being supported by the necessary DocumentedEvidence, it intends to enable the reception of a Permission."@en ;
                               rdfs:label "Request"@en .


###  https://w3id.org/vpa#Restriction
<https://w3id.org/vpa#Restriction> rdf:type owl:Class ;
                                   rdfs:comment "Issued by an Appropriate Body in connection with its documented evidence on a certain requirement, it contains all aspects to take into account in order to accept the DocumentedEvidence as proof, enabling the scope of the Permission. It is possible that the Restriction limits the Permission in the same way."@en ;
                                   rdfs:label "Restriction"@en .


###  https://w3id.org/vpa#Scope
