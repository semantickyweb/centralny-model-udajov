               rdfs:isDefinedBy <http://data.europa.eu/949/> ;
               rdfs:label "Type of signal"@en ;
               vs:term_status "stable" ;
               skos:scopeNote "Indicates what function the signal (on the track or in OP) executes in relation to the track/switches."@en .


