                          dcterms:created "2021-12-12"^^xsd:date ;
                          rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                          rdfs:label "Minimum radius of vertical curve"@en ;
                          vs:term_status "stable" ;
                          skos:scopeNote "Presentation of parameter 1.2.2.0.3.3 'Minimum radius of vertical curve'"@en .


###  http://data.europa.eu/949/NationalRegistrationProperty
era:NationalRegistrationProperty rdf:type owl:Class ;
                                 era:evrIndex "12" ;
                                 era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/NationalRegistrationPropertyShape> ;
                                 dcterms:created "2026-02-10"^^xsd:date ;
                                 rdfs:comment "A property defined at national level by a member state for vehicle registration purposes. Each member state may define its own set of such properties, identified by a national property identifier string. This class avoids creating individual era: predicates for each member-state-specific registration field. The member state is determined by the registeringMemberState of the parent VehicleRegistrationCase."@en ;
                                 rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                 rdfs:label "National Registration Property"@en ;
                                 vs:term_status "unstable" ;
                                 skos:example """A Polish registration property (DECISIONNUMBER field):
ex:reg-case-PL-001 a era:VehicleRegistrationCase ;
    era:registeringMemberState <http://publications.europa.eu/resource/authority/country/POL> ;
    era:hasNationalRegistrationProperty [
        a era:NationalRegistrationProperty ;
        era:nationalPropertyIdentifier <http://data.europa.eu/949/concepts/national-reg-props/PL/DECISIONNUMBER> ;
        era:nationalPropertyValue "DEC/2026/00123"
    ] .

# The expected datatype (xsd:string) is declared on the SKOS concept itself:
# <.../PL/DECISIONNUMBER> era:nationalPropertyExpectedDatatype
#     "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
# SHACL SPARQL constraints dynamically verify value datatypes via this path."""@en .


###  http://data.europa.eu/949/NationalRailwayLine
era:NationalRailwayLine rdf:type owl:Class ;
                        rdfs:subClassOf era:InfrastructureElement ;
