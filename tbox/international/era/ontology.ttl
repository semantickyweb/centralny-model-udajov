###  http://data.europa.eu/949/minimumWheelDiameter
era:minimumWheelDiameter rdf:type owl:DatatypeProperty ;
                         rdfs:subPropertyOf era:switchesAndCrossingsDataParameter ;
                         rdf:type owl:FunctionalProperty ;
                         rdfs:domain [ rdf:type owl:Class ;
                                       owl:unionOf ( era:CommonCharacteristicsSubset
                                                     era:RunningTrack
                                                )
                                  ] ;
                         rdfs:range xsd:integer ;
                         era:XMLName "ISC_MinWheelDiaFixObtuseCrossings" ;
                         era:applicable "Y" ;
                         era:formatNote "NNN" ;
                         era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                         era:rinfIndex "1.1.1.1.5.2" ;
                         era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/MinimumWheelDiameter> ;
                         era:unitOfMeasure unit:MilliM ;
                         era:usedInRCCCalculations "true"^^xsd:boolean ;
                         dcterms:created "2020-08-24"^^xsd:date ;
                         dcterms:modified "2021-09-10"^^xsd:date ,
                                          "2024-09-19"^^xsd:date ,
                                          "2025-02-28"^^xsd:date ,
                                          "2026-06-09"^^xsd:date ;
                         dcterms:source <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ;
                         rdfs:comment "Maximum unguided length of fixed obtuse crossings is based on a minimum wheel diameter in service expressed in millimetres."@en ;
                         rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                         rdfs:label "Minimum wheel diameter for fixed obtuse crossings"@en ;
                         rdfs:seeAlso "INF TSI:  4.2.5.3" ;
                         vs:term_status "stable" ;
                         skos:scopeNote """The minimum TSI value is 330 mm and this shall be used as a default value unless advised otherwise. If the value of the wheel diameter is bigger than 330 mm, it has to be specified.
New lines are assumed to be compliant with the TSI INF. When the line is compliant to TSI the default value of 330 mm has to be presented."""@en .

###  http://data.europa.eu/949/minInServiceWheelDiameter
