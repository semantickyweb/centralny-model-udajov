                                            <http://data.europa.eu/949/shapes/SignalType> ;
               era:tsiOPEAppendixD2Index "2.2.3" ,
                                         "2.3.3" ;
               dcterms:created "2022-10-27"^^xsd:date ;
               dcterms:modified "2024-01-08"^^xsd:date ,
                                "2024-04-18"^^xsd:date ,
