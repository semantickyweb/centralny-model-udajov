                                      era:inSkosConceptScheme <http://data.europa.eu/949/concepts/etcs-rbc-reject-reasons/ETCSRBCRejectionReasons> ;
                                      era:legalDeadline "12 months after publication of Article 7 Guide"@en ;
                                      era:rinfIndex "1.1.1.3.2.15" ,
                                                    "1.2.1.1.1.15" ;
                                      era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/InSkosConceptScheme> ,
                                                                   <http://data.europa.eu/949/shapes/ReasonsEtcsRadioBlockCenterReject> ;
                                      era:tsiOPEAppendixD3Index "1.4" ;
                                      dcterms:created "2022-11-07"^^xsd:date ;
                                      dcterms:modified "2023-03-14"^^xsd:date ,
                                                       "2024-04-18"^^xsd:date ,
                                                       "2024-09-19"^^xsd:date ,
                                                       "2026-02-27"^^xsd:date ;
                                      dcterms:relation era:etcsLevelType ;
                                      dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
                                      rdfs:comment "List of cases subject to system design choices made by the infrastructure manager according to the specification referenced in Appendix A-1, index [C]"@en ;
                                      rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                      rdfs:label "Reasons for which an ETCS Radio Block Center can reject a train"@en ;
                                      rdfs:seeAlso "https://www.era.europa.eu/domains/technical-specifications-interoperability/control-command-and-signalling-tsi_en#oe-content-paragraph-1632"^^xsd:anyURI ;
                                      vs:term_status "stable" ;
                                      skos:scopeNote """1. Distinguish between mandatory and optional: decision was only to record the mandatory ones, but optional reasons can be added.
2. Providing the non-implemented CR-solution which have been accepted by IM, after check/approval with RU's, is also allowed."""@en .


