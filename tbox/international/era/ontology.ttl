###  http://data.europa.eu/949/tNvcontact
era:tNvcontact rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf era:etcsNationalValuesDataParameter ;
               rdf:type owl:FunctionalProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( era:CommonCharacteristicsSubset
                                           era:ETCS
                                         )
                           ] ;
               rdfs:range [ rdf:type rdfs:Datatype ;
                            owl:onDatatype xsd:unsignedInt ;
                            owl:withRestrictions ( [ xsd:minInclusive "0"^^xsd:unsignedInt
                                                   ]
                                                   [ xsd:maxInclusive "255"^^xsd:unsignedInt
                                                   ]
                                                 )
                          ] ;
               era:applicable "Y/N/NYA" ;
               era:dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
               era:formatNote "NNN, with N as a digit from 0 to 9. Value NNN = 255 means ∞ (infinity), so values cannot be higher." ;
               era:legalDeadline "12 months after publication of Article 7 Guide"@en ;
               era:rinfIndex "1.1.1.3.2.16.8" ,
                             "1.2.1.1.1.16.8" ;
               era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/TNvcontact> ,
                                            <http://data.europa.eu/949/shapes/TNvcontactApplicability> ;
               era:tsiOPEAppendixD3Index "1.5.8" ;
               era:unitOfMeasure unit:SEC ;
               dcterms:created "2022-11-07"^^xsd:date ;
               dcterms:modified "2023-03-14"^^xsd:date ,
                                "2024-04-18"^^xsd:date ,
                                "2024-12-05"^^xsd:date ,
                                "2025-02-28"^^xsd:date ,
                                "2026-02-27"^^xsd:date ;
               dcterms:relation era:etcsLevelType ;
               dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
               rdfs:comment """Maximum time without a safe message from Radio Block Center before train reacts in seconds.
According to the specification referenced in Appendix A-1, index [C]"""@en ;
               rdfs:isDefinedBy <http://data.europa.eu/949/> ;
               rdfs:label "T_NVCONTACT"@en ;
               rdfs:seeAlso "https://www.era.europa.eu/domains/technical-specifications-interoperability/control-command-and-signalling-tsi_en#oe-content-paragraph-1632"^^xsd:anyURI ;
               rdfs:seeAslo "TSI CCS (Subset 26, chapter 7. 7.5.1.148 T_NVCONTACT)" ;
               vs:term_status "stable" ;
               skos:scopeNote "Precision: [NNN], with N a decimal number (0÷9), NNN = 255 means ∞ seconds, so values cannot be higher."@en .


