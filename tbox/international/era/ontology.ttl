###  http://data.europa.eu/949/endLocation
era:endLocation rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf era:tunnelObjParameter ,
                                   gsp:hasGeometry ;
                rdfs:domain era:Tunnel ;
                rdfs:range sf:Point ;
                era:XMLName "SOLTunnelEnd" ;
                era:applicable "Y" ;
                era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                era:rinfIndex "1.1.1.1.8.4" ;
                era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/EndLocation> ;
