                                         rdfs:domain era:TrainDetectionSystem ;
                                         rdfs:range skos:Concept ;
                                         era:inSkosConceptScheme <http://data.europa.eu/949/concepts/train-detection/FrenchTrainDetectionSystemLimitations> ;
                                         era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/InSkosConceptScheme> ;
                                         dcterms:created "2020-08-24"^^xsd:date ;
                                         dcterms:isReplacedBy era:frenchTrainDetectionSystemLimitationApplicable ,
                                                              era:frenchTrainDetectionSystemLimitationNumber ,
                                                              era:tdsFrenchTrainDetectionSystemLimitation ;
                                         dcterms:modified "2022-04-05"^^xsd:date ;
                                         rdfs:comment "Specific for route compatibility check on French network. The reason for deprecation is because of replacement by a class, an object property and two datatype properties. The reason is that the property is composed of two values: A boolean [Y/N] and  a number N is between 1 and 8."@en ;
                                         rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                         rdfs:label "Section with train detection limitation, only for the French network"@en ;
                                         owl:deprecated "true"^^xsd:boolean ;
                                         vs:term_status "stable" .


###  http://data.europa.eu/949/frenchTrainDetectionSystemLimitationNumber
era:frenchTrainDetectionSystemLimitationNumber rdf:type owl:ObjectProperty ;
                                               rdfs:domain era:FrenchTrainDetectionSystemLimitation ;
                                               rdfs:range skos:Concept ;
                                               era:inSkosConceptScheme <http://data.europa.eu/949/concepts/train-detection-numbers/FrenchTrainDetectionSystemLimitationNumbers> ;
                                               era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/InSkosConceptScheme> ,
                                                                            <http://data.europa.eu/949/shapes/FrenchTrainDetectionSystemLimitationNumber> ;
                                               dcterms:created "2023-04-05"^^xsd:date ;
                                               dcterms:modified "2024-04-18"^^xsd:date ,
                                                                "2025-02-18"^^xsd:date ,
                                                                "2025-03-11"^^xsd:date ;
                                               dcterms:relation era:frenchTrainDetectionSystemLimitationApplicable ,
                                                                era:tdsFrenchTrainDetectionSystemLimitation ;
                                               dcterms:replaces era:frenchTrainDetectionSystemLimitation ;
                                               rdfs:comment """Part of the section with train detection limitation that indicates the type of train detection limitation.

Specific for route compatibility check on French network.

Sections with:
[1] Tonnage circulated per track is inferior to 15000 tons/day/track
[2] Directional Interlocking
[3] 45-second delay for directional interlocking
[4] Installation with track circuit announcement
[5] Absence of a shunting assistance pedal in the normal direction of circulation for non-reversible double track lines
[6] Absence of a shunting assistance pedal regardless of the direction of traffic for single track lines and tracks for two way working
[7] Absence of a pedal announcement mechanism
[8] 45-second delay for specific announcement reset devices"""@en ;
                                               rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                               rdfs:label "Section with train detection limitation number, only for French network"@en ;
                                               vs:term_status "stable" .


