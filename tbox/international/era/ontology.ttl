###  http://data.europa.eu/949/magneticBrakingConditionsDocument
era:magneticBrakingConditionsDocument rdf:type owl:ObjectProperty ;
                                      rdfs:subPropertyOf era:trackResistanceToAppliedLoadsObjParameter ;
                                      rdfs:domain [ rdf:type owl:Class ;
                                                    owl:unionOf ( era:CommonCharacteristicsSubset
                                                                  era:RunningTrack
                                                                )
                                                  ] ;
                                      rdfs:range era:Document ;
                                      era:XMLName "ILR_MBDocRef" ;
                                      era:applicable "Y/N" ;
