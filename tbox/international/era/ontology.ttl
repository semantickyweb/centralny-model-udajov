             dcterms:modified "2026-02-13"^^xsd:date ;
             rdfs:comment "ERA-specific activity aligned with prov:Activity (W3C PROV-O), used to describe changes affecting ERA resources."@en ;
             rdfs:isDefinedBy <http://data.europa.eu/949/> ;
             rdfs:label "Activity"@en ;
             vs:term_status "unstable" .

###  http://data.europa.eu/949/AxleSpacing
era:AxleSpacing rdf:type owl:Class ;
                dcterms:created "2025-02-21"^^xsd:date ;
                rdfs:comment "Stub class for axle spacing "@en ;
                era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/AxleSpacingShape> ;
                rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                rdfs:label "Axle spacing"@en .

###  http://data.europa.eu/949/Body
era:Body rdf:type owl:Class ;
