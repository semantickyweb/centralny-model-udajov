###  http://data.europa.eu/949/hasNoiseLevelLimit
era:hasNoiseLevelLimit rdf:type owl:DatatypeProperty ;
                       rdfs:subPropertyOf era:networkStatementsDataCharacteristic ;
                       rdf:type owl:FunctionalProperty ;
                       era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasNoiseLevelLimit> ;
                       rdfs:domain era:SectionOfLine ;
                       rdfs:range xsd:boolean ;
                       dcterms:created "2025-09-29"^^xsd:date ;
                       dcterms:relation era:maxNoiseLevelOfSoL ;
                       rdfs:comment "Indicate, if there are any limits on noise levels."@en ;
