era-sh:TrainDetectionSystemType rdfs:comment "Indication of types of train detection system installed."@en;
  :affectedClass :TrainDetectionSystem .

era-sh:TrainDetectionSystemTypeSKOS rdfs:comment "Indication of types of train detection system installed."@en;
  :affectedClass :TrainDetectionSystem .

era-sh:TsiPantographHeadApplicability rdfs:comment "Indication of TSI compliant pantograph heads which are allowed to be used."@en;
  :affectedClass :RunningTrack .

era-sh:TsiPantographHeadSKOS rdfs:comment "Accepted TSI compliant pantograph heads."@en;
  :affectedClass :RunningTrack .

era-sh:TunnelDocRef rdfs:comment "Electronic document available from the IM stored by the Agency with precise description of the clearance gauge and geometry of the tunnel"@en;
  :affectedClass :Tunnel .

era-sh:TypeOfTraffic rdfs:comment "Classification of the type of traffic carried on the railway line"@en;
  :affectedClass :TENTCorridor .

era-sh:TypeOfTrafficSKOS rdfs:comment "Classification of the type of traffic carried on the railway line"@en;
  :affectedClass :TENTCorridor .

era-sh:Validity rdfs:comment "Relates a feature with a temporal feature to indicate a validity period. "@en;
  :affectedClass :Feature .

era-sh:VoiceRadioCompatible rdfs:comment "Radio requirements used for demonstrating technical compatibility voice. "@en;
  :affectedClass :RunningTrack .

era-sh:VoiceRadioCompatibleApplicability rdfs:comment "GSM-R (parameter 1.1.1.3.3.1) must be installed for this parameter to be applicable. "@en;
  :affectedClass :RunningTrack .

era-sh:VoiceRadioCompatibleSKOS rdfs:comment "Radio requirements used for demonstrating technical compatibility voice. "@en;
  :affectedClass :RunningTrack .

era-sh:WheelSetGauge rdfs:comment "A single value expressed in millimeters that identifies the track gauge. "@en;
  :affectedClass :RunningTrack .

era-sh:WheelSetGaugeSKOS rdfs:comment "A single value expressed in millimeters that identifies The track gauge. "@en;
  :affectedClass :RunningTrack .

era-sh:HasGeometry rdfs:comment "Geographical coordinates in decimal degrees normally given for the centre of the OP. "@en;
  :affectedClass :Feature .

era-sh:HasBeginning rdfs:comment "Applicability interval defines the date interval in which a characteristic of an infrastructure element is applicable."@en;
  :affectedClass :ParameterApplicability .

era-sh:HasEnd rdfs:comment "Applicability interval defines the date interval in which a characteristic of an infrastructure element is applicable."@en;
  :affectedClass :ParameterApplicability .

era-sh:AppliesInBothDirections rdfs:comment "Specifies if the section applies in both directions (optional). "@en;
  :affectedClass :LinearElementSection .

era-sh:AreaBoardingAid rdfs:comment "Information of the train access level for which the boarding aid can be used. "@en;
  :affectedClass :PlatformEdge .

era-sh:AssistanceStartingTrain rdfs:comment """Indication of existence of equipment or staff supporting the train crew in starting the train.
Fixed equipment (for example mirrors or CCTV cameras) or station staff indicating to train crew or driver when to close doors and whether this has been done successfully. """@en;
  :affectedClass :PlatformEdge .

era-sh:AutomaticDroppingDeviceRequired rdfs:comment "Indication of the requirement of automatic dropping device."@en;
  :affectedClass :RunningTrack .

