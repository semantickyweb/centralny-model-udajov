era-sh:RadioNetworkIdApplicability sh:prefixes <http://data.europa.eu/949/>;
  sh:select """
    SELECT DISTINCT $this ?label (era:radioNetworkId AS ?path)
			WHERE {
                 $this era:gsmRVersion ?gsmRVersion.
        OPTIONAL { $this rdfs:label ?label0 } .
