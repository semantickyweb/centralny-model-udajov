		era-organisation-roles:ECM-a
		era-organisation-roles:ECM-b
		era-organisation-roles:ECM-c
		era-organisation-roles:ECM-d
	) ;
	sh:maxCount "1"^^xsd:integer ;
	sh:minCount "1"^^xsd:integer ;
	sh:name "Permission type"@en ;
	sh:nodeKind sh:IRI ;
	sh:path vpa:permits ;
	.

