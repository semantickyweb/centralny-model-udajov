era-sh:ECMCertBodyPreviousCertificateShape
	a sh:PropertyShape ;
	era:affectedProperty era:relatedCertificate ;
	sh:datatype xsd:string ;
	sh:description "Reference to a previous certificate with format CC/30/MMMM/NNNN" ;
