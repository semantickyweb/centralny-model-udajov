era-sh:NSAOrganisationRoleShape
	a sh:NodeShape ;
	sh:description "Defines the role classification for National Safety Authorities" ;
	sh:nodeKind sh:IRI ;
	sh:property
		era-sh:NSAOrganisationIsFromRUShape-SCA ,
		era-sh:NSAOrganisationIsFromRUShape-SCB
		;
