		era-sh:ECM-CB-ECMTypesAllowedShape ,
		era-sh:ECM-CB-MaintenanceFunctionsShape ,
		era-sh:ECM-CB-VTCategoriesShape ,
		era-sh:ECM-CB-VTSubCategoriesShape ,
		era-sh:ECMCB-HS-OperationShape ,
		era-sh:ECMCB-RID-OperationShape ,
		era-sh:ECMCBIdentifierShape ,
		era-sh:ECMCBTypeShape ,
		era-sh:ECMCertBodyApplicableNationalLegislationShape ,
		era-sh:ECMCertBodyCertificationBodyShape ,
