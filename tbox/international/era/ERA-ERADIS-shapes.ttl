	sh:severity sh:Violation ;
	.

era-sh:Article7DerogationComplianceResultSKOS
	a sh:SPARQLConstraint ;
	era:affectedProperty era:complianceResult ;
	sh:message "Article 7 derogation compliance has an era:complianceResult value {?concept} that is not a member of the Article 7 TSI non-application reasons collection."@en ;
	sh:prefixes <http://data.europa.eu/949/> ;
	sh:select """
        SELECT $this ?concept (era:complianceResult AS ?path)
        WHERE {
            $this era:complianceResult ?concept .
            FILTER NOT EXISTS {
                <http://data.europa.eu/949/concepts/compliance-check-result/Article7NonApplicationReasons>
                    <http://www.w3.org/2004/02/skos/core#member> ?concept .
            }
        }
    """ ;
	sh:severity sh:Violation ;
	.

era-sh:Article7DerogationComplianceShape
	a sh:NodeShape ;
	rdfs:label "Article 7 derogation compliance"@en ;
	rdfs:comment "Validates compliance resources representing Article 7 TSI non-application derogations."@en ;
	sh:property
		era-sh:Article7DerogationComment ,
		era-sh:Article7DerogationComplianceResult
		;
	sh:sparql era-sh:Article7DerogationComplianceResultSKOS ;
	sh:target [
