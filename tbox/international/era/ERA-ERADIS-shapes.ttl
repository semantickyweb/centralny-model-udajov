era-sh:ECMHasRoleShape
	a sh:PropertyShape ;
	era:affectedProperty era:hasOrganisationRole ;
	sh:class skos:Concept ;
	sh:description "Specifies the type of company which holds the ECM certificate" ;
	sh:in (
