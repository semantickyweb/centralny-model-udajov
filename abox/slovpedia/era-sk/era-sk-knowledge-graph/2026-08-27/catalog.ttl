<https://slovpedia.eu/catalog/era> a dcat:Catalog ;
    dct:title "Slovpedia – slovenské železničné dáta ERA"@sk,
        "Slovpedia – Slovak ERA railway data"@en ;
    dct:description "Logické datasety slovenského grafu ERA 0056 rozdelené podľa dôležitých tried ERA. Pôvodné ERA URI sa nemenia."@sk,
        "Logical datasets from Slovak ERA graph 0056, separated by important ERA classes. Original ERA IRIs are preserved."@en ;
    dct:publisher <https://data.gov.sk/id/legal-subject/56978090> ;
    foaf:homepage <https://slovpedia.eu/> ;
    dcat:dataset
        <https://slovpedia.eu/dataset/era/operational-points>,
        <https://slovpedia.eu/dataset/era/sections-of-line>,
        <https://slovpedia.eu/dataset/era/running-tracks>,
        <https://slovpedia.eu/dataset/era/sidings>,
        <https://slovpedia.eu/dataset/era/platform-edges>,
        <https://slovpedia.eu/dataset/era/tunnels>,
        <https://slovpedia.eu/dataset/era/contact-line-systems>,
        <https://slovpedia.eu/dataset/era/train-detection-systems>,
        <https://slovpedia.eu/dataset/era/etcs>,
        <https://slovpedia.eu/dataset/era/kilometric-posts>,
        <https://slovpedia.eu/dataset/era/primary-locations> .

